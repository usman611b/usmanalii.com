---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Skills & Capabilities — usmanalii.com" description="Verifiable skills taxonomy and evidence-backed capabilities" currentPath="/skills">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-4">
      <h1 class="text-3xl font-bold text-white tracking-tight">Skills Graph & Bounded Capabilities</h1>
      <p class="text-sm text-[#9CAAC1] max-w-2xl">
        Capabilities are action-oriented abilities with descriptive maturity states derived from evidence. No arbitrary percentage bars are used.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#8B5CF6] font-mono">Taxonomy: Distributed Systems</span>
        <h2 class="text-lg font-bold text-white mt-1">Cloudflare Workers & Hono API Design</h2>
        <p class="text-xs text-[#9CAAC1] mt-2">
          Implements typed REST APIs with JWT security middleware, WebCrypto validation, and D1 database transactions.
        </p>
        <div class="mt-4 flex items-center justify-between text-xs">
          <span class="px-2 py-1 rounded bg-[#22D3EE]/10 text-[#22D3EE] font-medium">Maturity: Delivered</span>
          <span class="text-[#9CAAC1]">Evidence-backed</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
