---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArchitectureCanvas } from '../components/ArchitectureCanvas';
import { ModeSwitcher } from '../components/ModeSwitcher';

interface ProjectCaseStudy {
  title: string;
  slug: string;
  summary: string;
  status: string;
  role: string;
  timeline: string;
  language: string;
  stack: string;
  adrs: Array<{ id: string; title: string; summary: string }>;
  constraintText: string;
  decisionText: string;
  experimentText: string;
  debuggingText: string;
  outcomeText: string;
}

const eligibleProjectCaseStudy = null as unknown as ProjectCaseStudy | null;
---

<BaseLayout
  title="Technical Deep Dive — USMAN ALI"
  description="Technical architecture, ADRs, experiments, debugging lessons, and source provenance for verified engineering systems."
  currentPath="/deep-dive"
>
  <!-- Deep-dive mode context banner -->
  <div
    class="border-b"
    style="border-color: var(--border-magenta); background: rgba(255,45,170,0.04);"
  >
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span
          class="badge badge-magenta"
          aria-label="Currently in Deep Dive mode"
        >
          Deep Dive Mode
        </span>
        <span class="text-xs" style="color: var(--text-muted);">
          Architecture · ADRs · Provenance · Source
        </span>
      </div>
      <div class="flex items-center gap-3 text-xs" style="color: var(--text-muted);">
        <span style="font-family: var(--font-mono);">Switch mode:</span>
        <ModeSwitcher initialMode="deep-dive" client:load />
      </div>
    </div>
  </div>

  <div class="public-page-shell max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    {
      eligibleProjectCaseStudy ? (
        <div class="space-y-8">

          <!-- Case Study Header -->
          <header class="space-y-4 max-w-3xl">
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <span class="badge badge-lime">
                <span class="w-1.5 h-1.5 rounded-full" style="background: var(--lime);" />
                VERIFIED EVIDENCE
              </span>
              <span style="color: var(--text-muted); font-family: var(--font-mono);">
                STATUS: <span style="color: var(--text-primary);">{eligibleProjectCaseStudy?.status}</span>
              </span>
            </div>

            <h1
              class="font-display uppercase leading-none"
              style="font-family: var(--font-display); font-size: clamp(3rem, 7vw, 6rem); color: var(--text-primary);"
            >
              {eligibleProjectCaseStudy?.title}
            </h1>
            <p class="text-lg leading-relaxed" style="color: var(--text-secondary); max-width: 60ch;">
              {eligibleProjectCaseStudy?.summary}
            </p>
          </header>

          <hr class="luminous-rule" aria-hidden="true" />

          <!-- Architecture grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-8">
              <ArchitectureCanvas client:load />
            </div>

            <div
              class="lg:col-span-4 rounded-xl p-5 space-y-4"
              style="background: var(--surface-card); border: 1px solid var(--hairline);"
            >
              <div class="flex items-center justify-between text-xs">
                <span style="color: var(--violet); font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;">
                  Architecture Decisions
                </span>
                <a href="/evidence" style="color: var(--violet);" class="hover:underline">
                  View all →
                </a>
              </div>

              <div class="space-y-4 text-xs">
                {eligibleProjectCaseStudy?.adrs?.map(
                  (adr: { id: string; title: string; summary: string }) => (
                    <div class="border-b pb-3 space-y-1" style="border-color: var(--hairline);">
                      <div style="color: var(--cyan); font-weight: 700; font-family: var(--font-mono);">{adr.id}</div>
                      <div class="font-semibold" style="color: var(--text-primary);">{adr.title}</div>
                      <div style="color: var(--text-muted);">{adr.summary}</div>
                    </div>
                  ),
                )}
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="deep-dive-observatory max-w-4xl mx-auto py-16 text-center space-y-8">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-semibold uppercase"
            style="background: rgba(255,45,170,0.08); border: 1px solid var(--border-magenta); color: var(--magenta); font-family: var(--font-mono);"
          >
            <span class="w-1.5 h-1.5 rounded-full" style="background: var(--magenta);" />
            Deep Dive Engine
          </div>

          <h1
            class="font-display uppercase leading-none"
            style="font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 5rem); color: var(--text-primary);"
          >
            Project Deep-Dive
          </h1>

          <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 56ch; margin: 0 auto;">
            Technical architecture maps, ADR decision trees, load-testing experiments,
            and debugging lessons — for owner-approved project case studies.
          </p>

          <!-- Honest empty state card -->
          <div
            class="p-8 rounded-2xl text-center space-y-5"
            style="background: var(--surface-card); border: 1px dashed var(--border-magenta);"
          >
            <div
              class="text-xs font-semibold uppercase tracking-widest"
              style="color: var(--magenta); font-family: var(--font-mono);"
            >
              No public case study selected
            </div>
            <p class="text-sm" style="color: var(--text-muted); max-width: 40ch; margin: 0 auto;">
              Project case studies and architecture decision records are published
              from approved database revisions. No data is manufactured.
            </p>

            <!-- Evidence chain overview -->
            <div
              class="mt-4 text-xs p-4 rounded-lg text-left space-y-2"
              style="background: var(--elevated); border: 1px solid var(--hairline); font-family: var(--font-mono); color: var(--text-muted);"
            >
              <div>chain: Project → ADRs → Experiments → Debugging Lessons → Outcomes</div>
              <div>verified: every record links to supporting evidence in the ledger</div>
              <div>published: case studies require owner approval before public access</div>
            </div>

            <div class="pt-2 flex gap-3 justify-center">
              <a href="/projects" class="btn btn-outline-cyan">
                Browse Projects →
              </a>
              <a href="/evidence" class="btn btn-ghost">
                Evidence Ledger
              </a>
            </div>
          </div>

          <!-- What deep-dive exposes -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
            {
              [
                { icon: '◈', label: 'Architecture', color: 'var(--cyan)', desc: 'System design, dependency maps, infrastructure choices' },
                { icon: '◉', label: 'Decisions', color: 'var(--violet)', desc: 'ADRs, trade-off analysis, rejected alternatives' },
                { icon: '◇', label: 'Evidence', color: 'var(--magenta)', desc: 'Experiments, debugging lessons, deployment artifacts' },
              ].map((item) => (
                <div
                  class="rounded-xl p-4 space-y-2"
                  style={`background: var(--surface-card); border: 1px solid var(--hairline);`}
                >
                  <div style={`color: ${item.color}; font-family: var(--font-mono); font-size: 18px;`}>
                    {item.icon}
                  </div>
                  <div class="text-sm font-semibold" style="color: var(--text-primary);">{item.label}</div>
                  <div class="text-xs" style="color: var(--text-muted);">{item.desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
