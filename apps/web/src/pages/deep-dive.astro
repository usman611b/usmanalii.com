---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Deep Dive — usmanalii.com"
  description="Technical architecture, ADRs, experiments, and debugging lessons"
  currentPath="/deep-dive"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-4">
      <span class="text-xs font-semibold text-[#EC4899] uppercase tracking-wider"
        >Technical Evaluator View</span
      >
      <h1 class="text-3xl font-bold text-white tracking-tight">
        Engineering Architecture & Deep Dive
      </h1>
      <p class="text-sm text-[#9CAAC1] max-w-2xl">
        Inspect system design, Architecture Decision Records (ADRs), experiments, failure
        post-mortems, and debugging lessons.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#22D3EE] font-mono">Architecture</span>
        <h2 class="text-lg font-bold text-white mt-1">14-Package Monorepo Scaffold</h2>
        <p class="text-xs text-[#9CAAC1] mt-2">
          Pure domain layer strictly separated from Cloudflare adapters via ESLint boundary rules.
        </p>
      </div>

      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#A78BFA] font-mono">ADRs</span>
        <h2 class="text-lg font-bold text-white mt-1">Decided ADRs 001–010</h2>
        <p class="text-xs text-[#9CAAC1] mt-2">
          Static Astro rebuilds, Hono REST conventions, WebCrypto RS256 auth, and encrypted backups.
        </p>
      </div>

      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#EC4899] font-mono">Security</span>
        <h2 class="text-lg font-bold text-white mt-1">Zero-Trust Cloudflare Access</h2>
        <p class="text-xs text-[#9CAAC1] mt-2">
          Cryptographic signature verification, key rotation cache, and fail-closed private API
          routes.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
