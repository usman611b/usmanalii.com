---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DeepDiveExplorer } from '../components/DeepDiveExplorer';
---

<BaseLayout
  title="Technical Deep Dives — USMAN ALI"
  description="Explore evidence-backed engineering case studies: architecture, decisions, experiments, debugging, deployments, outcomes, and source provenance."
  currentPath="/deep-dive"
>
  <div class="deep-mode-banner">
    <div>
      <span class="badge badge-magenta">Deep Dive Mode</span>
      <p>Architecture · Decisions · Experiments · Failures · Outcomes · Proof</p>
    </div>
  </div>
  <div class="public-page-shell deep-dive-shell">
    <DeepDiveExplorer client:load />
  </div>
</BaseLayout>
