---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RecruiterResumeView } from '../components/RecruiterResumeView';
import { ModeSwitcher } from '../components/ModeSwitcher';
---

<BaseLayout
  title="Recruiter Mode — Usman Ali"
  description="Evidence-backed recruiter projection — capabilities, verified projects, and résumé. Designed for a 60-second scan."
  currentPath="/recruiter"
>
  <!-- Recruiter mode context banner -->
  <div
    class="border-b"
    style="border-color: var(--border-violet); background: rgba(139,92,246,0.05);"
  >
    <div
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <div class="flex items-center gap-3">
        <span class="badge badge-violet" aria-label="Currently in Recruiter Mode">
          Recruiter Mode
        </span>
        <span class="text-xs" style="color: var(--text-muted);">
          Outcome-first scan — designed for 60–90 seconds
        </span>
      </div>
      <div class="flex items-center gap-3 text-xs" style="color: var(--text-muted);">
        <span style="font-family: var(--font-mono);">Switch mode:</span>
        <ModeSwitcher initialMode="recruiter" client:load />
      </div>
    </div>
  </div>

  <div class="public-page-shell mx-auto max-w-7xl px-4 py-12">
    <RecruiterResumeView client:load />
  </div>
</BaseLayout>
