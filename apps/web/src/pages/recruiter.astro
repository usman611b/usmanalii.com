---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Recruiter View — usmanalii.com" description="Concise role-oriented professional summary for recruiters" currentPath="/recruiter">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="p-8 rounded-2xl glass-panel space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <span class="text-xs font-semibold text-[#A78BFA] uppercase tracking-wider">Recruiter Quick Scan (&lt;90 Seconds)</span>
          <h1 class="text-3xl font-bold text-white mt-1">Usman Ali</h1>
          <p class="text-sm text-[#9CAAC1] mt-1">Systems Architect & Senior Software Engineer</p>
        </div>
        <a
          href="/contact"
          class="px-4 py-2 bg-[#22D3EE] text-[#050509] font-bold text-xs rounded-lg hover:opacity-90 transition-opacity"
        >
          Contact Usman
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[#22D3EE]">Core Delivered Capabilities</h2>
          <ul class="mt-3 space-y-2 text-xs text-[#9CAAC1]">
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE]"></span>
              <span class="text-white font-medium">Cloudflare Workers & Distributed Microservices</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE]"></span>
              <span class="text-white font-medium">TypeScript Strict Type Systems & Monorepos</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#22D3EE]"></span>
              <span class="text-white font-medium">Zero-Trust Auth & WebCrypto Security</span>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[#EC4899]">Key Proof Points</h2>
          <ul class="mt-3 space-y-2 text-xs text-[#9CAAC1]">
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#EC4899]"></span>
              <span>100% Evidence-Backed Professional Claims</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#EC4899]"></span>
              <span>Lifetime-Free Architecture on Cloudflare Stack</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
