---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PortraitHero } from '../components/PortraitHero';
import { HomeLiveSummary } from '../components/HomeLiveSummary';
import { ActivityHeatmap } from '../components/ActivityHeatmap';
import { SkillsEvidenceGraph } from '../components/SkillsEvidenceGraph';
import { ContactSection } from '../components/ContactSection';
---

<BaseLayout
  title="USMAN ALI — Engineering, evidenced."
  description="Personal Career OS and evidence-backed engineering archive of Usman Ali — a living record of what he learns, builds, decides, debugs, and ships."
  currentPath="/"
>
  <PortraitHero client:load />

  <section id="overview" class="record-observatory" aria-labelledby="record-heading">
    <header class="record-intro">
      <div>
        <p class="section-eyebrow">The living record</p>
        <h2 id="record-heading">A LIVING RECORD,<br />NOT A STATIC RÉSUMÉ.</h2>
      </div>
      <p>
        Learning compounds. Context is preserved. Every published professional record comes from the
        approved application data—not from decorative demo content.
      </p>
    </header>

    <div id="evidence-system" class="home-system-panel home-live-system">
      <div class="panel-heading">
        <span>Recent verified evidence</span>
        <a href="/evidence">View the ledger →</a>
      </div>
      <HomeLiveSummary client:load />
    </div>

    <section
      id="activity-system"
      class="home-system-panel activity-panel activity-panel-featured"
      aria-labelledby="activity-heading"
    >
      <div class="panel-heading">
        <span id="activity-heading">365-day activity signal</span>
        <a href="/activity">View full activity →</a>
      </div>
      <ActivityHeatmap client:visible />
    </section>

    <div class="home-system-grid home-graph-grid">
      <section
        id="graph-system"
        class="home-system-panel graph-panel"
        aria-labelledby="graph-heading"
      >
        <div class="panel-heading">
          <span id="graph-heading">Career Knowledge Universe</span>
          <a href="/skills">Explore graph →</a>
        </div>
        <SkillsEvidenceGraph client:visible />
      </section>
    </div>

    <section id="projects-system" class="engineering-rail" aria-labelledby="engineering-heading">
      <p class="section-eyebrow">Engineering record</p>
      <h2 id="engineering-heading">DECIDE. EXPERIMENT. DEBUG. SHIP.</h2>
      <div class="engineering-links">
        <a href="/projects"
          ><span>01</span><strong>Projects</strong><small>Context, architecture and outcomes</small
          ></a
        >
        <a href="/deep-dive"
          ><span>02</span><strong>Deep Dive</strong><small
            >ADRs, experiments and debugging lessons</small
          ></a
        >
        <a href="/journey"
          ><span>03</span><strong>Journey</strong><small>The continuous learning record</small></a
        >
        <a href="/recruiter"
          ><span>04</span><strong>Recruiter View</strong><small
            >Evidence-backed professional identity</small
          ></a
        >
      </div>
    </section>

    <ContactSection client:load />
  </section>
</BaseLayout>
