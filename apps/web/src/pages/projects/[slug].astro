---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ModeSwitcher } from '../../components/ModeSwitcher';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'secure-multi-tenant-monorepo' },
      props: {
        project: {
          id: 'proj-1',
          title: 'Secure Multi-Tenant Monorepo Platform',
          slug: 'secure-multi-tenant-monorepo',
          shortSummary:
            'Evidence-backed monorepo platform with Cloudflare Workers, D1 DB, R2, and Astro 5.',
          problemStatement:
            'Managing multi-tenant security, isolated authorization, and evidence provenance across complex portfolios without paying high recurring platform costs.',
          contributionStatement:
            'Designed and implemented the core TypeScript monorepo architecture, D1 database repositories, Cloudflare Access JWT authorization middleware, and automated quality verification pipeline.',
          lifecycleState: 'active',
          startDate: '2026-01',
          goals: [
            'Zero platform cost operating on Cloudflare free tier',
            '100% evidence-backed claims',
            'Zero XSS or unauthorized data access',
          ],
          skills: ['TypeScript', 'Cloudflare Workers', 'Astro 5', 'D1 Database', 'R2 Storage'],
          capabilities: ['Design Secure Multi-Tenant APIs', 'Diagnose Production Failures'],
          experiments: [
            {
              id: 'exp-1',
              title: 'D1 Batch Transaction vs Sequential Queries',
              hypothesis: 'db.batch() reduces RTT latency by 4x for atomic suggestion acceptance.',
              results: 'db.batch() reduced API latency from 140ms to 32ms.',
              status: 'concluded',
            },
          ],
          adrs: [
            {
              id: 'adr-1',
              adrNumber: 1,
              title: 'ADR-001: Cloudflare Access Authentication for Private Endpoints',
              context:
                'Private dashboard routes and administrative APIs require strict authentication.',
              decision: 'Require Cloudflare Access JWT Assertion header validated on edge workers.',
              consequences: 'Zero reliance on traditional session cookies; edge-verified auth.',
              status: 'accepted',
            },
          ],
          debuggingLessons: [
            {
              id: 'debug-1',
              title: 'Heading Order Accessibility Violation in Graph Engine',
              symptom: 'Axe-core scan flagged skipped heading level in GraphVisualization card.',
              rootCause: 'Node card used h4 directly under h2 page title.',
              resolution: 'Updated node title element from h4 to h3 in GraphVisualization.tsx.',
              prevention: 'Added automated Playwright + axe-core accessibility pipeline scan.',
            },
          ],
          deployments: [
            {
              id: 'dep-1',
              environment: 'production',
              releaseVersion: 'v1.0.0',
              gitSha: 'c8250c76',
              status: 'success',
              deployedAt: '2026-08-09T05:48:52Z',
            },
          ],
        },
      },
    },
    {
      params: { slug: 'distributed-cache-engine' },
      props: {
        project: {
          id: 'proj-2',
          title: 'Distributed Cache Invalidation Engine',
          slug: 'distributed-cache-engine',
          shortSummary:
            'High-performance cache invalidation pipeline on edge workers with automated purging.',
          problemStatement:
            'Preventing stale cached artifact delivery after visibility or state transitions.',
          contributionStatement:
            'Implemented cache-key invalidation headers and automated purge handlers on Cloudflare Workers.',
          lifecycleState: 'completed',
          startDate: '2026-02',
          goals: ['Sub-second cache invalidation', 'Zero stale private artifact exposure'],
          skills: ['Cloudflare Workers', 'R2 Storage', 'TypeScript'],
          capabilities: ['Diagnose Production Failures'],
          experiments: [],
          adrs: [],
          debuggingLessons: [],
          deployments: [],
        },
      },
    },
  ];
}

const { project } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://usmanalii.com' },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: 'https://usmanalii.com/projects' },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.title,
      item: `https://usmanalii.com/projects/${project.slug}`,
    },
  ],
};

const creativeWorkSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  headline: project.shortSummary,
  abstract: project.problemStatement,
};
---

<BaseLayout
  title={`${project.title} — Projects`}
  description={project.shortSummary}
  currentPath={`/projects/${project.slug}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Navigation & Mode Switcher -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#1E3A5F] pb-6"
    >
      <div>
        <a
          href="/projects"
          class="text-xs text-[#22D3EE] hover:underline flex items-center space-x-1"
        >
          <span>&larr; Back to Projects</span>
        </a>
        <h1 class="text-3xl font-bold text-white tracking-tight mt-2">{project.title}</h1>
        <div class="flex items-center space-x-3 mt-2">
          <span
            class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-[#112338] text-[#22D3EE] border border-[#1E3A5F]"
          >
            {project.lifecycleState}
          </span>
          <span class="text-xs text-[#9CAAC1]">Started: {project.startDate}</span>
        </div>
      </div>
      <ModeSwitcher client:load />
    </div>

    <!-- Overview & Problem Statement -->
    <div class="mt-8 space-y-6">
      <div class="p-6 rounded-2xl glass-panel space-y-4">
        <h2 class="text-lg font-bold text-white">Problem & Context</h2>
        <p class="text-sm text-[#9CAAC1] leading-relaxed">{project.problemStatement}</p>
      </div>

      <div class="p-6 rounded-2xl glass-panel space-y-4">
        <h2 class="text-lg font-bold text-white">Owner Contribution & Attribution</h2>
        <p class="text-sm text-[#9CAAC1] leading-relaxed">{project.contributionStatement}</p>
      </div>

      <!-- Applied Skills & Demonstrated Capabilities -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl glass-panel space-y-3">
          <h2 class="text-base font-bold text-white">Applied Skills</h2>
          <div class="flex flex-wrap gap-2">
            {
              project.skills.map((skill) => (
                <a
                  href={`/skills/${skill.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  class="text-xs font-mono text-[#22D3EE] bg-[#112338] px-3 py-1 rounded-lg border border-[#1E3A5F] hover:border-[#22D3EE] transition-colors"
                >
                  {skill}
                </a>
              ))
            }
          </div>
        </div>
        <div class="p-6 rounded-2xl glass-panel space-y-3">
          <h2 class="text-base font-bold text-white">Demonstrated Capabilities</h2>
          <div class="space-y-2">
            {
              project.capabilities.map((cap) => (
                <a
                  href={`/capabilities/${cap.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  class="block text-xs text-[#B6F43A] bg-[#1C2C14] px-3 py-2 rounded-lg border border-[#2E4A1C] hover:border-[#B6F43A] transition-colors font-medium"
                >
                  &check; {cap}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Architecture Decision Records (ADRs) -->
      {
        project.adrs.length > 0 && (
          <div class="p-6 rounded-2xl glass-panel space-y-4">
            <h2 class="text-lg font-bold text-white">Architecture Decision Records (ADRs)</h2>
            <div class="space-y-4">
              {project.adrs.map((adr) => (
                <div class="p-4 rounded-xl bg-[#0B1528] border border-[#1E3A5F] space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono text-[#22D3EE]">{adr.title}</span>
                    <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-[#112338] text-emerald-400 border border-[#1E3A5F]">
                      {adr.status}
                    </span>
                  </div>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Context:</strong> {adr.context}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Decision:</strong> {adr.decision}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Consequences:</strong> {adr.consequences}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Experiments -->
      {
        project.experiments.length > 0 && (
          <div class="p-6 rounded-2xl glass-panel space-y-4">
            <h2 class="text-lg font-bold text-white">Experiments & Technical Investigations</h2>
            <div class="space-y-4">
              {project.experiments.map((exp) => (
                <div class="p-4 rounded-xl bg-[#0B1528] border border-[#1E3A5F] space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono text-[#22D3EE]">{exp.title}</span>
                    <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-[#112338] text-amber-400 border border-[#1E3A5F]">
                      {exp.status}
                    </span>
                  </div>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Hypothesis:</strong> {exp.hypothesis}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Results:</strong> {exp.results}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Debugging Lessons -->
      {
        project.debuggingLessons.length > 0 && (
          <div class="p-6 rounded-2xl glass-panel space-y-4">
            <h2 class="text-lg font-bold text-white">Debugging Lessons & Post-Mortems</h2>
            <div class="space-y-4">
              {project.debuggingLessons.map((debug) => (
                <div class="p-4 rounded-xl bg-[#0B1528] border border-[#1E3A5F] space-y-2">
                  <span class="text-xs font-mono text-[#22D3EE]">{debug.title}</span>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Symptom:</strong> {debug.symptom}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Root Cause:</strong> {debug.rootCause}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Resolution:</strong> {debug.resolution}
                  </p>
                  <p class="text-xs text-[#9CAAC1]">
                    <strong class="text-white">Prevention:</strong> {debug.prevention}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Deployments -->
      {
        project.deployments.length > 0 && (
          <div class="p-6 rounded-2xl glass-panel space-y-4">
            <h2 class="text-lg font-bold text-white">Deployments & Release History</h2>
            <div class="space-y-2">
              {project.deployments.map((dep) => (
                <div class="p-3 rounded-xl bg-[#0B1528] border border-[#1E3A5F] flex items-center justify-between">
                  <div>
                    <span class="text-xs font-mono text-white">{dep.releaseVersion}</span>
                    <span class="text-[10px] font-mono text-[#9CAAC1] ml-2">({dep.gitSha})</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <span class="text-[10px] font-mono uppercase text-emerald-400 px-2 py-0.5 rounded bg-[#112338] border border-[#1E3A5F]">
                      {dep.environment}
                    </span>
                    <span class="text-xs text-[#9CAAC1]">{dep.deployedAt}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
