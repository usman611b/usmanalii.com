---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ProjectCaseStudy } from '../../components/ProjectCaseStudy';
const slug = Astro.url.searchParams.get('slug') ?? Astro.params.slug;
export function getStaticPaths() {
  return [{ params: { slug: 'record' } }];
}
---

<BaseLayout title="Project Case Study — USMAN ALI" currentPath="/projects"
  ><main class="public-page-shell mx-auto max-w-7xl px-4 py-12">
    <ProjectCaseStudy fallbackSlug={slug} client:load />
  </main></BaseLayout
>
