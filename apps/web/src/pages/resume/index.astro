---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PublicResumeDirectory } from '../../components/PublicResumeDirectory';
---

<BaseLayout
  title="Published Résumé Variants"
  description="Owner-approved, evidence-backed résumé projections."
  currentPath="/resume"
  ><div class="public-page-shell mx-auto max-w-5xl space-y-8 px-4 py-12">
    <header class="public-page-header space-y-4">
      <span class="text-xs font-bold uppercase text-[#8B5CFF]">Canonical profile projections</span
      ><h1 class="public-page-title font-display uppercase text-white">Published Résumés</h1><p
        class="text-sm text-[#9CAAC1]"
      >
        Each variant is generated from published professional records and approved claims.
      </p>
    </header><PublicResumeDirectory client:load />
  </div></BaseLayout
>
