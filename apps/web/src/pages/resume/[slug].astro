---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PublicResumeView } from '../../components/PublicResumeView';
export function getStaticPaths() {
  return [{ params: { slug: 'record' } }];
}
---

<BaseLayout
  title="Published Résumé"
  description="Evidence-backed professional résumé."
  currentPath="/resume"
  ><style>
    @media print {
      nav,
      footer,
      .no-print {
        display: none !important;
      }
      .resume-container {
        background: #fff !important;
        color: #000 !important;
        box-shadow: none !important;
      }
      .resume-container * {
        color: #000 !important;
      }
    }
  </style><div class="mx-auto max-w-4xl px-4 py-12">
    <PublicResumeView client:load />
  </div></BaseLayout
>
