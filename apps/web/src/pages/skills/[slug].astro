---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RecordDetail } from '../../components/RecordDetail';
const slug = Astro.url.searchParams.get('slug') ?? Astro.params.slug;
export function getStaticPaths() {
  return [{ params: { slug: 'record' } }];
}
---

<BaseLayout title="Skill — USMAN ALI" currentPath="/skills"
  ><div class="public-page-shell mx-auto max-w-7xl px-4 py-12">
    <RecordDetail endpointBase="/api/v1/public/skills" fallbackKey={slug} client:load />
  </div></BaseLayout
>
