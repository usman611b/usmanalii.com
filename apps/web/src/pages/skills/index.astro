---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SkillsEvidenceGraph } from '../../components/SkillsEvidenceGraph';

const publicSkills = [
  {
    name: 'TypeScript Strict Systems',
    slug: 'typescript',
    category: 'programming_language',
    description:
      'Statically typed superset of JavaScript used across Cloudflare Workers APIs, D1 repositories, and Astro SSG frontend.',
    evidenceCount: 14,
  },
  {
    name: 'API Security & OAuth/Access',
    slug: 'api-security',
    category: 'security',
    description:
      'Cryptographic Access JWT verification, RS256 token validation, CSRF origin enforcement, and zero-trust IDOR boundary design.',
    evidenceCount: 9,
  },
  {
    name: 'Distributed Edge Microservices',
    slug: 'edge-microservices',
    category: 'architecture',
    description:
      'Low-latency TypeScript edge services deployed on Cloudflare Workers with D1 transactions and R2 object storage.',
    evidenceCount: 11,
  },
];
---

<BaseLayout title="Skills Taxonomy & Graph — USMAN ALI" currentPath="/skills">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    <div class="space-y-4">
      <div
        class="inline-flex items-center space-x-2 px-3 py-1 rounded-md bg-[#08111F] border border-[#8B5CFF]/30 font-mono-tech text-xs text-[#8B5CFF]"
      >
        <span class="w-2 h-2 rounded-full bg-[#8B5CFF] animate-pulse"></span>
        <span>EVIDENCE-BACKED SKILLS GRAPH</span>
      </div>

      <h1
        class="text-6xl sm:text-7xl font-display font-bold tracking-tight text-white uppercase leading-none"
      >
        SKILLS TAXONOMY &amp; CONSTELLATION
      </h1>
      <p class="text-base text-[#9CAAC1] max-w-2xl">
        Proven capabilities backed by verifiable code commits, architecture decision records, and
        production deployments. Zero self-rated percentage bars.
      </p>
    </div>

    <!-- Skills Graph Visualization Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Graph Canvas (7 Cols) -->
      <div class="lg:col-span-7">
        <SkillsEvidenceGraph client:load />
      </div>

      <!-- Skills Cards Grid (5 Cols) -->
      <div class="lg:col-span-5 space-y-4 font-mono-tech">
        {
          publicSkills.map((skill) => (
            <a
              href={`/skills/${skill.slug}`}
              class="p-5 rounded-2xl glass-panel border border-white/10 hover:border-[#8B5CFF]/50 transition-all group block space-y-2"
            >
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold uppercase text-[#8B5CFF] tracking-wider">
                  {skill.category.replace('_', ' ')}
                </span>
                <span class="text-[#9CAAC1] text-[11px]">{skill.evidenceCount} Verified Items</span>
              </div>
              <h2 class="text-xl font-bold text-white group-hover:text-[#8B5CFF] transition-colors font-display uppercase tracking-wide">
                {skill.name}
              </h2>
              <p class="text-xs text-[#9CAAC1] leading-relaxed">{skill.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
