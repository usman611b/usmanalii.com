---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SkillsEvidenceGraph } from '../../components/SkillsEvidenceGraph';
import { PublicRecordDirectory } from '../../components/PublicRecordDirectory';
---

<BaseLayout
  title="Skills Taxonomy & Evidence Graph — USMAN ALI"
  description="Proven technical capabilities backed by verifiable evidence — zero self-rated percentage bars."
  currentPath="/skills"
>
  <div class="public-page-shell max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    <!-- Page header -->
    <header class="public-page-header space-y-4 max-w-2xl">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-semibold tracking-widest uppercase"
        style="background: rgba(139,92,246,0.08); border: 1px solid var(--border-violet); color: var(--violet); font-family: var(--font-mono);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--violet);" aria-hidden="true"
        ></span>
        Evidence-backed Skills Graph
      </div>

      <h1
        class="public-page-title font-display uppercase leading-none"
        style="font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5rem); color: var(--text-primary);"
      >
        Skills & Constellation
      </h1>

      <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 60ch;">
        Proven capabilities backed by verifiable code commits, architecture decision records, and
        production deployments. Zero self-rated percentage bars.
      </p>

      <!-- No percentage bars notice -->
      <div
        class="inline-flex items-center gap-2 text-xs rounded-lg px-3 py-2"
        style="background: rgba(184,255,61,0.06); border: 1px solid var(--border-lime); color: var(--lime); font-family: var(--font-mono);"
      >
        ✓ Evidence-strength qualitative scale — no percentage proficiency bars
      </div>
    </header>

    <!-- Graph + Directory layout -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
      <!-- Graph canvas — 7 cols -->
      <div class="xl:col-span-7">
        <SkillsEvidenceGraph client:load />
      </div>

      <!-- Skills directory — 5 cols -->
      <div class="xl:col-span-5">
        <div class="rounded-xl overflow-hidden" style="border: 1px solid var(--hairline);">
          <div
            class="px-5 py-4 border-b"
            style="border-color: var(--hairline); background: rgba(139,92,246,0.05);"
          >
            <h2
              class="text-sm font-semibold"
              style="color: var(--text-primary); font-family: var(--font-mono);"
            >
              Skills Directory
            </h2>
            <p class="text-[11px] mt-0.5" style="color: var(--text-muted);">
              All published skill records
            </p>
          </div>
          <div class="p-4">
            <PublicRecordDirectory kind="skills" client:load />
          </div>
        </div>
      </div>
    </div>

    <!-- Capabilities CTA -->
    <div
      class="rounded-xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5"
      style="background: var(--surface-card); border: 1px solid var(--hairline);"
    >
      <div class="space-y-1.5">
        <h2 class="text-lg font-bold" style="color: var(--text-primary);">
          Explore Verifiable Capabilities
        </h2>
        <p class="text-sm" style="color: var(--text-secondary); max-width: 52ch;">
          Inspect public capability outcomes, evidence strength, and relational graph paths.
        </p>
      </div>
      <a href="/capabilities" class="btn btn-outline-cyan whitespace-nowrap"> Capabilities → </a>
    </div>
  </div>
</BaseLayout>
