---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { JournalArticle } from '../../components/JournalArticle';
---

<BaseLayout
  title="Authenticated Content Preview — usmanalii.com"
  description="Exact public preview rendered using the same component pipeline."
  currentPath="/journey/preview"
>
  <link rel="canonical" href="https://usmanalii.com/dashboard/journal" slot="head" />
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <meta name="referrer" content="no-referrer" slot="head" />

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-6">
    <div
      class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono flex items-center justify-between"
    >
      <span>● AUTHENTICATED PREVIEW MODE (Cloudflare Access & Token Bound)</span>
      <span class="text-[10px] text-[#9CAAC1]">Private Preview — Unindexed / No-Store</span>
    </div>

    <JournalArticle client:load />
  </div>
</BaseLayout>
