---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'monorepo-security-architecture' } },
    { params: { slug: 'building-versioned-json-block-content-engine' } },
  ];
}

const { slug } = Astro.params;

// Mock entry data for static generation
const entryMap: Record<
  string,
  { title: string; contentType: string; occurredAt: string; summary: string; blocks: any[] }
> = {
  'monorepo-security-architecture': {
    title: 'Monorepo Security Architecture & WebCrypto JWT Pipeline',
    contentType: 'deep_dive',
    occurredAt: '2026-08-08',
    summary:
      'Architectural documentation of RS256 token verification, Cloudflare Access integration, CSP headers, and fail-closed D1 storage.',
    blocks: [
      { id: 'b1', type: 'heading', level: 2, text: 'Architectural Rationale' },
      {
        id: 'b2',
        type: 'paragraph',
        text: 'To ensure absolute single-owner authorization security for usmanalii.com, Cloudflare Access JWT assertions are cryptographically validated using WebCrypto Subtitle APIs inside Worker middleware.',
      },
      {
        id: 'b3',
        type: 'code_block',
        language: 'typescript',
        code: `export async function verifyAccessJwt(jwt: string, jwksUrl: string): Promise<JwtValidationResult> {
  const { header, payload, signature } = parseJwtParts(jwt);
  const key = await getPublicKeyFromJwks(jwksUrl, header.kid);
  const valid = await crypto.subtle.verify('RSASSA-PKCS1-v1_5', key, signature, data);
  return { valid };
}`,
      },
      {
        id: 'b4',
        type: 'callout',
        calloutType: 'note',
        title: 'Fail-Closed Guarantee',
        text: 'Unauthenticated requests to /dashboard or /api/v1/private/* immediately terminate with HTTP 401 AUTH_REQUIRED.',
      },
    ],
  },
  'building-versioned-json-block-content-engine': {
    title: 'Building the Versioned JSON-Block Content Engine (M2)',
    contentType: 'journal',
    occurredAt: '2026-08-08',
    summary:
      'Design and implementation of canonical structured JSON blocks, optimistic concurrency version_no, GFM export, and publication validation.',
    blocks: [
      {
        id: 'b1',
        type: 'heading',
        level: 2,
        text: 'Canonical JSON Blocks & Portable Markdown Export',
      },
      {
        id: 'b2',
        type: 'paragraph',
        text: 'All content entries store body content in versioned JSON block arrays (v1). Every entry automatically compiles to standard GitHub-Flavored Markdown for lifetime portability.',
      },
    ],
  },
};

const entry =
  entryMap[slug || 'monorepo-security-architecture'] || entryMap['monorepo-security-architecture'];
const canonicalUrl = `https://usmanalii.com/journey/${slug}`;
---

<BaseLayout
  title={`${entry?.title} — usmanalii.com`}
  description={entry?.summary || 'Learning journey entry'}
  currentPath={`/journey/${slug}`}
>
  <link rel="canonical" href={canonicalUrl} slot="head" />
  <meta property="og:title" content={entry?.title} slot="head" />
  <meta property="og:description" content={entry?.summary} slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <meta property="og:url" content={canonicalUrl} slot="head" />

  <!-- JSON-LD Structured Data -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: entry?.title,
      description: entry?.summary,
      datePublished: entry?.occurredAt,
      author: {
        '@type': 'Person',
        name: 'Usman Ali',
        url: 'https://usmanalii.com',
      },
    })}
    slot="head"
  />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <!-- Breadcrumb Nav -->
    <div>
      <a
        href="/journey"
        class="text-xs text-[#9CAAC1] hover:text-[#22D3EE] transition-colors inline-flex items-center gap-1"
      >
        ← Back to Learning Journey
      </a>
    </div>

    <!-- Article Header -->
    <div class="space-y-4 border-b border-white/10 pb-8">
      <div class="flex items-center gap-2">
        <span
          class="px-2.5 py-0.5 text-[10px] font-mono rounded-full bg-[#22D3EE]/10 text-[#22D3EE] border border-[#22D3EE]/20 font-semibold uppercase"
        >
          {entry?.contentType.replace('_', ' ')}
        </span>
        <span class="text-xs text-[#9CAAC1] font-mono">{entry?.occurredAt}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">{entry?.title}</h1>
      <p class="text-base text-[#9CAAC1] leading-relaxed">{entry?.summary}</p>
    </div>

    <!-- Rendered Blocks Output -->
    <div class="space-y-6 text-[#F7FBFF] leading-relaxed">
      {
        entry?.blocks.map((block) => {
          if (block.type === 'heading') {
            return <h2 class="text-2xl font-bold text-white mt-8 mb-4">{block.text}</h2>;
          }
          if (block.type === 'paragraph') {
            return <p class="text-sm sm:text-base text-[#9CAAC1]">{block.text}</p>;
          }
          if (block.type === 'code_block') {
            return (
              <div class="p-4 rounded-xl bg-[#0B101F] border border-white/10 overflow-x-auto font-mono text-xs text-[#22D3EE]">
                <pre>
                  <code>{block.code}</code>
                </pre>
              </div>
            );
          }
          if (block.type === 'callout') {
            return (
              <div class="p-4 rounded-xl bg-[#22D3EE]/10 border border-[#22D3EE]/30 text-xs space-y-1">
                {block.title && <h3 class="font-bold text-[#22D3EE]">{block.title}</h3>}
                <p class="text-white">{block.text}</p>
              </div>
            );
          }
          return null;
        })
      }
    </div>
  </article>
</BaseLayout>
