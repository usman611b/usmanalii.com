---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PublicRecordDirectory } from '../components/PublicRecordDirectory';
---

<BaseLayout
  title="Projects & Case Studies — USMAN ALI"
  description="Evidence-backed engineering case studies detailing problem context, architecture decisions, experiments, debugging lessons, and outcomes."
  currentPath="/projects"
>
  <div class="public-page-shell max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10">
    <!-- Page header -->
    <header class="public-page-header space-y-4 max-w-3xl">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-semibold tracking-widest uppercase"
        style="background: rgba(37,230,255,0.08); border: 1px solid var(--border-cyan); color: var(--cyan); font-family: var(--font-mono);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--cyan);" aria-hidden="true"
        ></span>
        Evidence-backed Case Studies
      </div>

      <h1
        class="public-page-title font-display uppercase leading-none"
        style="font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5rem); color: var(--text-primary);"
      >
        Projects & Architecture
      </h1>

      <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 68ch;">
        Engineering case studies documenting system architecture, constraints, ADRs, experiments,
        failure post-mortems, and verified outcomes. Each project links to supporting evidence.
      </p>

      <!-- Project narrative arc -->
      <div
        class="inline-flex items-center gap-2 text-xs rounded-lg px-3 py-2"
        style="background: var(--surface-quiet); border: 1px solid var(--hairline); color: var(--text-muted); font-family: var(--font-mono);"
        aria-label="Project story structure"
        role="note"
      >
        Context → Constraint → Decision → Implementation → Experiment → Outcome → Evidence
      </div>
    </header>

    <hr class="luminous-rule" aria-hidden="true" />

    <PublicRecordDirectory kind="projects" client:load />
  </div>
</BaseLayout>
