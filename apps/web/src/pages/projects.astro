---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — usmanalii.com" description="Engineering case studies and project records" currentPath="/projects">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-4">
      <h1 class="text-3xl font-bold text-white tracking-tight">Projects & Engineering Case Studies</h1>
      <p class="text-sm text-[#9CAAC1] max-w-2xl">
        Complete case studies with architecture decisions, experiments, ADRs, debugging lessons, and outcomes.
      </p>
    </div>

    <div class="mt-12 space-y-6">
      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#B6F43A] font-mono font-semibold">Active Project</span>
        <h2 class="text-xl font-bold text-white mt-1">usmanalii.com — Personal Career OS</h2>
        <p class="text-xs text-[#9CAAC1] mt-2 leading-relaxed">
          Lifetime-free architecture built on Astro 5, Cloudflare Workers, D1 database, R2 storage, and Tailwind CSS.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
