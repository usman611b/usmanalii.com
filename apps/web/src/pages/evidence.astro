---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PublicRecordDirectory } from '../components/PublicRecordDirectory';
---

<BaseLayout
  title="Evidence Ledger — USMAN ALI"
  description="Public, owner-approved engineering evidence: verified artifacts, architecture decisions, experiment results, and deployment records."
  currentPath="/evidence"
>
  <div class="public-page-shell max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10">
    <!-- Page header -->
    <header class="public-page-header space-y-4 max-w-2xl">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-semibold tracking-widest uppercase"
        style="background: rgba(37,230,255,0.08); border: 1px solid var(--border-cyan); color: var(--cyan); font-family: var(--font-mono);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--cyan);" aria-hidden="true"
        ></span>
        Verified Public Records
      </div>

      <h1
        class="public-page-title font-display uppercase leading-none"
        style="font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5rem); color: var(--text-primary);"
      >
        Evidence Ledger
      </h1>

      <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 60ch;">
        Only public, owner-approved evidence loaded from the database. Each record includes
        verification state, provenance, and relationship to capabilities.
      </p>

      <!-- Evidence type legend -->
      <div class="flex flex-wrap gap-2 pt-2" aria-label="Evidence type legend" role="group">
        <span class="badge badge-cyan">Evidence</span>
        <span class="badge badge-violet">Decision / ADR</span>
        <span class="badge badge-magenta">Experiment</span>
        <span class="badge badge-lime">Shipped Outcome</span>
        <span class="badge badge-amber">Lesson / Debugging</span>
      </div>
    </header>

    <hr class="luminous-rule" aria-hidden="true" />

    <PublicRecordDirectory kind="evidence" client:load />
  </div>
</BaseLayout>
