---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — usmanalii.com"
  description="Professional narrative and biography of Usman Ali"
  currentPath="/about"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-3xl font-bold text-white tracking-tight">About Usman Ali</h1>
      <p class="text-base text-[#9CAAC1] leading-relaxed">
        Systems architect and software engineer focusing on low-latency edge architectures,
        verifiable evidence models, and clean software design.
      </p>
    </div>
  </div>
</BaseLayout>
