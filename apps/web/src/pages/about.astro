---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PublicIdentityView } from '../components/PublicIdentityView';
---

<BaseLayout
  title="About — Usman Ali"
  description="Canonical public profile — background, capabilities, experience, and approved professional claims."
  currentPath="/about"
>
  <div class="public-page-shell max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">
    <!-- Page header -->
    <header class="public-page-header space-y-4 max-w-2xl">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-semibold tracking-widest uppercase"
        style="background: rgba(139,92,246,0.08); border: 1px solid var(--border-violet); color: var(--violet); font-family: var(--font-mono);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background: var(--violet);" aria-hidden="true"
        ></span>
        Canonical Public Profile
      </div>

      <h1
        class="public-page-title font-display uppercase leading-none"
        style="font-family: var(--font-display); font-size: clamp(3rem, 6vw, 5rem); color: var(--text-primary);"
      >
        About Usman Ali
      </h1>

      <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 60ch;">
        Professional identity, capabilities, and approved claims — all sourced from the published
        database. No AI-invented facts.
      </p>
    </header>

    <hr class="luminous-rule" aria-hidden="true" />

    <PublicIdentityView mode="about" client:load />
  </div>
</BaseLayout>
