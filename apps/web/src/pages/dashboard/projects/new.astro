---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Create Project — Dashboard"
  description="Create a new engineering project case study"
  currentPath="/dashboard/projects/new"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-2 border-b border-[#1E3A5F] pb-6">
      <a href="/dashboard/projects" class="text-xs text-[#22D3EE] hover:underline"
        >&larr; Back to Projects</a
      >
      <h1 class="text-2xl font-bold text-white tracking-tight">Create New Engineering Project</h1>
      <p class="text-xs text-[#9CAAC1]">
        Initialize an evidence-backed project record. All new projects default to private.
      </p>
    </div>

    <form class="mt-8 space-y-6">
      <div class="space-y-4 p-6 rounded-2xl glass-panel">
        <div>
          <label for="project-title" class="block text-xs font-semibold text-white mb-1"
            >Project Title</label
          >
          <input
            type="text"
            id="project-title"
            required
            placeholder="e.g. Distributed Cache Invalidation Engine"
            class="w-full bg-[#0B1528] border border-[#1E3A5F] rounded-xl px-4 py-2.5 text-xs text-white placeholder-[#4C5D77] focus:outline-none focus:border-[#22D3EE]"
          />
        </div>

        <div>
          <label for="project-slug" class="block text-xs font-semibold text-white mb-1">Slug</label>
          <input
            type="text"
            id="project-slug"
            required
            placeholder="e.g. distributed-cache-engine"
            class="w-full bg-[#0B1528] border border-[#1E3A5F] rounded-xl px-4 py-2.5 text-xs text-white placeholder-[#4C5D77] focus:outline-none focus:border-[#22D3EE]"
          />
        </div>

        <div>
          <label for="project-summary" class="block text-xs font-semibold text-white mb-1"
            >Short Summary</label
          >
          <textarea
            id="project-summary"
            rows="3"
            placeholder="High-level overview of the project..."
            class="w-full bg-[#0B1528] border border-[#1E3A5F] rounded-xl px-4 py-2.5 text-xs text-white placeholder-[#4C5D77] focus:outline-none focus:border-[#22D3EE]"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="lifecycle-state" class="block text-xs font-semibold text-white mb-1"
              >Lifecycle State</label
            >
            <select
              id="lifecycle-state"
              class="w-full bg-[#0B1528] border border-[#1E3A5F] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#22D3EE]"
            >
              <option value="active">Active</option>
              <option value="planning">Planning</option>
              <option value="completed">Completed</option>
              <option value="maintained">Maintained</option>
              <option value="paused">Paused</option>
            </select>
          </div>

          <div>
            <label for="visibility" class="block text-xs font-semibold text-white mb-1"
              >Visibility</label
            >
            <select
              id="visibility"
              class="w-full bg-[#0B1528] border border-[#1E3A5F] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#22D3EE]"
            >
              <option value="private">Private (Default)</option>
              <option value="public">Public</option>
            </select>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end space-x-4">
        <a href="/dashboard/projects" class="text-xs text-[#9CAAC1] hover:underline">Cancel</a>
        <button
          type="submit"
          class="px-6 py-2.5 rounded-xl bg-[#22D3EE] text-[#0B1528] text-xs font-bold hover:bg-[#67E8F9] transition-colors"
        >
          Create Project
        </button>
      </div>
    </form>
  </div>
</BaseLayout>
