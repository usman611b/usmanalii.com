---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: 'proj-1' } }, { params: { id: 'proj-2' } }];
}

const { id } = Astro.params;
---

<DashboardLayout title={`ADRs — ${id}`}>
  <div class="adrs-container card">
    <a href={`/dashboard/projects/${id}`} class="back-link">← Back to Overview</a>
    <h1 class="text-2xl font-bold mt-2">Architecture Decision Records (ADRs)</h1>

    <div class="adrs-list mt-4 mb-6">
      <div class="adr-card p-4 border rounded mb-3 bg-surface">
        <div class="flex justify-between items-center mb-1">
          <h2 class="font-bold text-lg">ADR-001: Cloudflare Access Identity Boundary</h2>
          <span class="badge badge-success">ACCEPTED</span>
        </div>
        <p class="text-sm">
          <strong>Context:</strong> Require verified single-tenant owner authentication on private endpoints.
        </p>
        <p class="text-sm mt-1">
          <strong>Decision:</strong> Validate JWT signature and Access Service Tokens at Cloudflare Edge
          middleware.
        </p>
      </div>
    </div>

    <form class="new-adr-form border-t pt-4">
      <h2 class="text-lg font-semibold mb-3">Create Architecture Decision Record</h2>
      <div class="form-row mb-3">
        <div class="form-group">
          <label for="adrNumber">ADR Number</label>
          <input type="number" id="adrNumber" value="2" min="1" required />
        </div>
        <div class="form-group">
          <label for="title">Title</label>
          <input type="text" id="title" placeholder="ADR title..." required />
        </div>
      </div>
      <div class="form-group mb-3">
        <label for="context">Context</label>
        <textarea id="context" rows="2" placeholder="Context & problem statement..." required
        ></textarea>
      </div>
      <div class="form-group mb-3">
        <label for="decision">Decision</label>
        <textarea id="decision" rows="2" placeholder="Architecture decision..." required></textarea>
      </div>
      <div class="form-group mb-3">
        <label for="consequences">Consequences</label>
        <textarea
          id="consequences"
          rows="2"
          placeholder="Positive and negative consequences..."
          required></textarea>
      </div>
      <button type="submit" class="button button-primary">Save ADR</button>
    </form>
  </div>
</DashboardLayout>

<style>
  .adrs-container {
    padding: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }
  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }
  .form-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-4);
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  input,
  select,
  textarea {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: inherit;
    font: inherit;
  }
</style>
