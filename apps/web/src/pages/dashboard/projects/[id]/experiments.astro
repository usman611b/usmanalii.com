---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: 'proj-1' } }, { params: { id: 'proj-2' } }];
}

const { id } = Astro.params;
---

<DashboardLayout title={`Experiments — ${id}`}>
  <div class="experiments-container card">
    <a href={`/dashboard/projects/${id}`} class="back-link">← Back to Overview</a>
    <h1 class="text-2xl font-bold mt-2">Engineering Experiments</h1>

    <div class="experiments-list mt-4 mb-6">
      <div class="exp-card p-4 border rounded mb-3 bg-surface">
        <div class="flex justify-between items-center mb-2">
          <h3 class="font-bold text-lg">D1 Concurrency Batching Strategy</h3>
          <span class="badge badge-success">CONCLUDED</span>
        </div>
        <p class="text-sm">
          <strong>Hypothesis:</strong> Batching SQL queries using D1 <code>db.batch()</code> reduces RPC
          latency by 60% compared to sequential statements.
        </p>
        <p class="text-sm mt-1">
          <strong>Conclusion:</strong> Confirmed. Batching reduced worker execution duration from 120ms
          to 45ms.
        </p>
      </div>
    </div>

    <form class="new-exp-form border-t pt-4">
      <h2 class="text-lg font-semibold mb-3">Record New Experiment</h2>
      <div class="form-group mb-3">
        <label for="title">Title</label>
        <input type="text" id="title" placeholder="Experiment title..." required />
      </div>
      <div class="form-group mb-3">
        <label for="hypothesis">Hypothesis</label>
        <textarea id="hypothesis" rows="2" placeholder="Empirical hypothesis..." required
        ></textarea>
      </div>
      <div class="form-group mb-3">
        <label for="methodology">Methodology</label>
        <textarea id="methodology" rows="2" placeholder="Testing methodology..." required
        ></textarea>
      </div>
      <button type="submit" class="button button-primary">Create Experiment</button>
    </form>
  </div>
</DashboardLayout>

<style>
  .experiments-container {
    padding: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }
  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  input,
  select,
  textarea {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: inherit;
    font: inherit;
  }
</style>
