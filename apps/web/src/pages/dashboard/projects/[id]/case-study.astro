---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: 'proj-1' } }, { params: { id: 'proj-2' } }];
}

const { id } = Astro.params;

const mockBlocks = [
  { type: 'heading', level: 2, text: 'Problem & Architectural Requirements' },
  {
    type: 'paragraph',
    text: 'Designing a secure multi-tenant architecture on Cloudflare Workers requires strict isolation, D1 transaction safety, and verifiable evidence provenance.',
  },
  {
    type: 'callout',
    calloutType: 'note',
    title: 'Security Requirement',
    text: 'All public endpoints must execute zero-trust validation and fail closed with opaque 404 responses.',
  },
];
---

<DashboardLayout title={`Case Study Editor — ${id}`}>
  <div class="case-study-editor card">
    <div class="header-nav">
      <a href={`/dashboard/projects/${id}`} class="back-link">← Back to Overview</a>
      <h1>Structured Case Study Authoring (ADR-005 JSON Blocks)</h1>
      <span class="autosave-status" id="autosaveStatus">Autosave: Saved</span>
    </div>

    <div class="block-controls mb-4">
      <button type="button" class="button button-sm button-secondary">+ Add Heading</button>
      <button type="button" class="button button-sm button-secondary">+ Add Paragraph</button>
      <button type="button" class="button button-sm button-secondary">+ Add Code Block</button>
      <button type="button" class="button button-sm button-secondary">+ Add Callout</button>
    </div>

    <div class="blocks-container" id="blocksContainer">
      {
        mockBlocks.map((block, idx) => (
          <div class="block-item card mb-3">
            <div class="block-header text-sm text-dim mb-1">
              Block #{idx + 1} — [{block.type.toUpperCase()}]
            </div>
            <textarea class="block-text-input" rows="2">
              {block.text}
            </textarea>
          </div>
        ))
      }
    </div>

    <section class="revision-history mt-6 pt-4 border-t">
      <h2 class="text-xl font-bold mb-3">Revision History & Rollback</h2>
      <ul class="revision-list text-sm">
        <li class="revision-item mb-2">
          <strong>Revision #3</strong> — 2026-08-09 01:00:00 (Current Published Snapshot)
        </li>
        <li class="revision-item mb-2">
          <strong>Revision #2</strong> — 2026-08-08 18:30:00 — <em>Updated ADR callout</em>
          <button class="button button-xs button-secondary ml-2">Rollback to #2</button>
        </li>
        <li class="revision-item mb-2">
          <strong>Revision #1</strong> — 2026-08-08 12:00:00 — <em>Initial draft creation</em>
          <button class="button button-xs button-secondary ml-2">Rollback to #1</button>
        </li>
      </ul>
    </section>
  </div>
</DashboardLayout>

<style>
  .case-study-editor {
    padding: var(--space-6);
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .back-link {
    color: var(--color-primary);
    text-decoration: none;
  }
  .autosave-status {
    font-size: var(--font-size-xs);
    color: var(--color-success);
    font-weight: 500;
  }
  .block-item {
    background: var(--color-background);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
  }
  .block-text-input {
    width: 100%;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    resize: vertical;
  }
  .revision-list {
    list-style: none;
    padding: 0;
  }
  .revision-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2);
    background: var(--color-background);
    border-radius: var(--radius-sm);
  }
</style>
