---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: 'proj-1' } }, { params: { id: 'proj-2' } }];
}

const { id } = Astro.params;
---

<DashboardLayout title={`Versions — ${id}`}>
  <div class="versions-container card">
    <a href={`/dashboard/projects/${id}`} class="back-link">← Back to Overview</a>
    <h1 class="text-2xl font-bold mt-2">Versions & Milestones</h1>

    <div class="versions-list mt-4 mb-6">
      <div class="version-card p-4 border rounded mb-3 bg-surface">
        <div class="flex justify-between items-center mb-1">
          <h3 class="font-bold text-lg">v1.0.0 — Production Baseline</h3>
          <span class="badge badge-success">RELEASED</span>
        </div>
        <p class="text-sm">
          Completed M0-M5 architecture milestone with complete D1 database and test suite.
        </p>
      </div>
    </div>

    <form class="new-version-form border-t pt-4">
      <h2 class="text-lg font-semibold mb-3">Create Version Milestone</h2>
      <div class="form-row mb-3">
        <div class="form-group">
          <label for="name">Milestone Name</label>
          <input type="text" id="name" placeholder="Name..." required />
        </div>
        <div class="form-group">
          <label for="versionIdentifier">Version Identifier</label>
          <input type="text" id="versionIdentifier" placeholder="v1.1.0" required />
        </div>
      </div>
      <div class="form-group mb-3">
        <label for="changelog">Changelog</label>
        <textarea id="changelog" rows="2" placeholder="Version changelog..."></textarea>
      </div>
      <button type="submit" class="button button-primary">Save Version</button>
    </form>
  </div>
</DashboardLayout>

<style>
  .versions-container {
    padding: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }
  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  input,
  select,
  textarea {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: inherit;
    font: inherit;
  }
</style>
