---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: 'proj-1' } }, { params: { id: 'proj-2' } }];
}

const { id } = Astro.params;

const mockProject = {
  id,
  title: 'Secure Multi-Tenant Monorepo System',
  slug: 'secure-multi-tenant-monorepo',
  visibility: 'public',
  publicationState: 'published',
  shortSummary:
    'High-assurance Cloudflare Workers monorepo with D1 database, R2 storage, and evidence provenance.',
  role: 'Principal System Architect',
  startDate: '2026-01-01',
  endDate: null,
  versionNo: 3,
};
---

<DashboardLayout title={`Dashboard — Project ${id}`}>
  <header class="project-header card card-highlight glow-border">
    <div class="header-top">
      <a href="/dashboard/projects" class="back-link">← Back to Projects</a>
      <span class="badge badge-success">{mockProject.publicationState.toUpperCase()}</span>
      <span class="badge badge-info">{mockProject.visibility.toUpperCase()}</span>
    </div>

    <h1 class="text-3xl font-bold mt-2">{mockProject.title}</h1>
    <p class="text-secondary mt-1">{mockProject.shortSummary}</p>
    <p class="text-sm text-dim mt-2">
      Role: <strong>{mockProject.role}</strong> | Version: #{mockProject.versionNo}
    </p>
  </header>

  <nav class="subnav-grid mt-6">
    <a href={`/dashboard/projects/${id}/edit`} class="subnav-card">
      <h2 class="subnav-title">⚙️ Project Metadata</h2>
      <p>Edit title, slug, visibility, embargo, scheduling, and role details.</p>
    </a>
    <a href={`/dashboard/projects/${id}/case-study`} class="subnav-card">
      <h2 class="subnav-title">📝 Case Study Authoring</h2>
      <p>Structured JSON blocks, autosave, local recovery, and revision rollback.</p>
    </a>
    <a href={`/dashboard/projects/${id}/contributions`} class="subnav-card">
      <h2 class="subnav-title">🤝 Contributions & Evidence</h2>
      <p>Attributions, explicit owner approvals, and evidence linkage.</p>
    </a>
    <a href={`/dashboard/projects/${id}/experiments`} class="subnav-card">
      <h2 class="subnav-title">🧪 Experiments</h2>
      <p>Hypotheses, methodology, variables, and empirical outcome records.</p>
    </a>
    <a href={`/dashboard/projects/${id}/adrs`} class="subnav-card">
      <h2 class="subnav-title">🏛 Architecture Decisions (ADRs)</h2>
      <p>Decision records, trade-offs, and supersession graph management.</p>
    </a>
    <a href={`/dashboard/projects/${id}/debugging`} class="subnav-card">
      <h2 class="subnav-title">🐛 Debugging Lessons</h2>
      <p>Symptom analysis, root-cause investigations, and prevention steps.</p>
    </a>
    <a href={`/dashboard/projects/${id}/deployments`} class="subnav-card">
      <h2 class="subnav-title">🚀 Deployments</h2>
      <p>Staging & production deployment logs and environment URL policies.</p>
    </a>
    <a href={`/dashboard/projects/${id}/versions`} class="subnav-card">
      <h2 class="subnav-title">📌 Versions & Milestones</h2>
      <p>Semantic version milestones, changelogs, and lineage chains.</p>
    </a>
    <a href={`/dashboard/projects/${id}/relationships`} class="subnav-card">
      <h2 class="subnav-title">🔗 Graph Relationships</h2>
      <p>Owner-scoped directed edges, skill links, and capability bindings.</p>
    </a>
  </nav>
</DashboardLayout>

<style>
  .project-header {
    padding: var(--space-6);
  }
  .header-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .subnav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .subnav-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }
  .subnav-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }
  .subnav-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-emphasis);
  }
  .subnav-card p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }
</style>
