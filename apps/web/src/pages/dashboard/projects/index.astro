---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { PrivateRecordDirectory } from '../../../components/dashboard/PrivateRecordDirectory';
---

<DashboardLayout title="Projects — Command Center" activeSection="projects"
  ><section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-white">Projects Management</h1><p
          class="mt-1 text-xs text-[#9CAAC1]"
        >
          Live project records from D1.
        </p>
      </div><a
        href="/dashboard/projects/new"
        class="rounded-lg bg-[#45F3FF] px-4 py-2 text-xs font-bold text-[#05060A]">Create project</a
      >
    </header><PrivateRecordDirectory kind="projects" client:load />
  </section></DashboardLayout
>
