---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ActivityHeatmap } from '../../components/ActivityHeatmap';
import { PrivateRecordDirectory } from '../../components/dashboard/PrivateRecordDirectory';
import { SkillsEvidenceGraph } from '../../components/SkillsEvidenceGraph';
import { DashboardOverview } from '../../components/dashboard/DashboardOverview';
---

<DashboardLayout title="Overview — Command Center" activeSection="overview">
  <div class="space-y-6 font-mono-tech">
    <DashboardOverview client:load />
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="glass-panel rounded-2xl p-5 space-y-3">
        <div class="flex justify-between">
          <h2 class="text-sm font-bold uppercase text-white">Private activity</h2><span
            class="text-[10px] text-[#9CAAC1]">365 days</span
          >
        </div><ActivityHeatmap isPrivateView={true} client:load />
      </section>
      <SkillsEvidenceGraph
        client:load
        privateView={true}
        endpointUrl="/api/v1/private/graph/career"
      />
      <PrivateRecordDirectory kind="projects" client:load />
      <PrivateRecordDirectory kind="journal" client:load />
    </div>
  </div>
</DashboardLayout>
