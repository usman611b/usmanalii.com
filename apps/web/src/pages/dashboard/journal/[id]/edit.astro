---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'edit-1' } },
    { params: { id: 'edit-2' } },
  ];
}

const { id } = Astro.params;
---

<DashboardLayout title={`Edit Entry ${id} — Private Dashboard`} activeSection="journal">
  <div class="space-y-6">
    <!-- Header Control Bar -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 border-b border-white/10 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <span id="save-status-badge" class="px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-500/20 text-emerald-400 font-semibold">● SYNCED</span>
          <span id="state-badge" class="px-2 py-0.5 text-[10px] font-mono rounded bg-amber-500/20 text-amber-300 font-semibold">DRAFT</span>
          <span class="text-xs text-[#9CAAC1]">Version 1</span>
        </div>
        <input
          type="text"
          id="entry-title-input"
          value="Building the Monorepo & Security Baseline (M0 & M1)"
          class="text-xl font-bold text-white bg-transparent border-none focus:outline-none mt-1 w-full focus:ring-1 focus:ring-[#22D3EE] rounded px-1"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          id="export-markdown-btn"
          href="#"
          class="px-3 py-1.5 bg-white/10 text-white text-xs font-semibold rounded-lg hover:bg-white/20 transition-colors"
        >
          Export Markdown
        </a>
        <button
          type="button"
          id="preview-toggle-btn"
          class="px-3 py-1.5 bg-[#A78BFA]/20 text-[#A78BFA] text-xs font-semibold rounded-lg hover:bg-[#A78BFA]/30 transition-colors"
        >
          Exact Preview
        </button>
        <button
          type="button"
          id="publish-btn"
          class="px-4 py-1.5 bg-[#22D3EE] text-[#050509] text-xs font-bold rounded-lg hover:opacity-90 transition-opacity"
        >
          Transition to Published
        </button>
      </div>
    </div>

    <!-- Main Editor Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2 Cols: JSON Block Editor -->
      <div class="lg:col-span-2 space-y-4">
        <div class="p-4 rounded-xl glass-panel space-y-3">
          <label class="block text-xs font-semibold text-[#9CAAC1]">Summary & Slug</label>
          <input
            type="text"
            id="entry-slug-input"
            value="monorepo-security-baseline"
            class="w-full px-3 py-1.5 bg-[#0B101F] border border-white/10 rounded-lg text-xs text-white placeholder-[#9CAAC1]"
          />
          <textarea
            id="entry-summary-input"
            rows="2"
            class="w-full px-3 py-1.5 bg-[#0B101F] border border-white/10 rounded-lg text-xs text-white placeholder-[#9CAAC1]"
          >Established the 14-package pnpm monorepo, strict TypeScript boundaries, WebCrypto RS256 JWT validation, and D1 migrations.</textarea>
        </div>

        <!-- Blocks Container -->
        <div id="blocks-container" class="space-y-4">
          <div class="p-4 rounded-xl glass-panel border border-white/10 space-y-2">
            <div class="flex items-center justify-between text-xs text-[#9CAAC1]">
              <span class="font-mono">Block 1 · Heading (Level 1)</span>
              <button type="button" class="text-rose-400 hover:underline text-[10px]">Remove</button>
            </div>
            <input
              type="text"
              value="Building the Monorepo & Security Baseline"
              class="w-full px-3 py-1.5 bg-[#0B101F] border border-white/10 rounded-lg text-sm text-white font-bold"
            />
          </div>

          <div class="p-4 rounded-xl glass-panel border border-white/10 space-y-2">
            <div class="flex items-center justify-between text-xs text-[#9CAAC1]">
              <span class="font-mono">Block 2 · Paragraph</span>
              <button type="button" class="text-rose-400 hover:underline text-[10px]">Remove</button>
            </div>
            <textarea
              rows="3"
              class="w-full px-3 py-1.5 bg-[#0B101F] border border-white/10 rounded-lg text-xs text-white"
            >We established a 14-package monorepo architecture using pnpm and Turbo. All internal dependencies are linked cleanly using workspace:* references.</textarea>
          </div>

          <div class="p-4 rounded-xl glass-panel border border-white/10 space-y-2">
            <div class="flex items-center justify-between text-xs text-[#9CAAC1]">
              <span class="font-mono">Block 3 · Code Block (TypeScript)</span>
              <button type="button" class="text-rose-400 hover:underline text-[10px]">Remove</button>
            </div>
            <textarea
              rows="4"
              class="w-full px-3 py-1.5 bg-[#0B101F] border border-white/10 rounded-lg text-xs text-[#22D3EE] font-mono"
            >export const onRequest: MiddlewareHandler = async (context, next) =&gt; &#123;
  const response = await next();
  response.headers.set('X-Content-Type-Options', 'nosniff');
  return response;
&#125;;</textarea>
          </div>
        </div>

        <!-- Add Block Controls -->
        <div class="p-4 rounded-xl glass-panel border border-dashed border-white/20 flex flex-wrap items-center gap-2">
          <span class="text-xs text-[#9CAAC1] mr-2">+ Add Block:</span>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Heading</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Paragraph</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Code</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Callout</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Quote</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Image</button>
          <button type="button" class="px-2.5 py-1 text-xs bg-white/10 text-white rounded hover:bg-white/20">+ Relationship Tag</button>
        </div>
      </div>

      <!-- Right Col: Sidebar Controls, Validation, Revisions -->
      <div class="space-y-4">
        <!-- Publication Validation Panel -->
        <div class="p-4 rounded-xl glass-panel space-y-3">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Publication Validation</h3>
          <div class="space-y-1.5 text-xs">
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>Required Metadata</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>Slug Validity</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>Effective Visibility</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>No Private Dependency Conflicts</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>Safe Content Allowed</span>
            </div>
            <div class="flex items-center gap-2 text-emerald-400">
              <span>✓</span> <span>Image Alt Text</span>
            </div>
          </div>
        </div>

        <!-- Relationship Selectors -->
        <div class="p-4 rounded-xl glass-panel space-y-3">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Linked Entities</h3>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[#22D3EE]/20 text-[#22D3EE]">@skill:TypeScript</span>
            <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[#22D3EE]/20 text-[#22D3EE]">@skill:Cloudflare Workers</span>
            <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[#A78BFA]/20 text-[#A78BFA]">@capability:RS256 JWT</span>
          </div>
          <button type="button" class="w-full py-1 text-xs bg-white/5 hover:bg-white/10 text-[#9CAAC1] rounded border border-white/10">
            + Link Skill / Evidence
          </button>
        </div>

        <!-- Immutable Revisions & Rollback -->
        <div class="p-4 rounded-xl glass-panel space-y-3">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Revision History</h3>
          <div class="space-y-2 text-xs">
            <div class="p-2.5 rounded-lg bg-white/5 border border-white/10 space-y-1">
              <div class="flex items-center justify-between font-mono text-[11px] text-white">
                <span>Rev #2 (Current)</span>
                <span class="text-[#9CAAC1]">22:15</span>
              </div>
              <p class="text-[11px] text-[#9CAAC1]">Added middleware code snippet block.</p>
            </div>

            <div class="p-2.5 rounded-lg bg-white/5 border border-white/5 space-y-1">
              <div class="flex items-center justify-between font-mono text-[11px] text-[#9CAAC1]">
                <span>Rev #1</span>
                <span>21:40</span>
              </div>
              <p class="text-[11px] text-[#9CAAC1]">Initial draft creation.</p>
              <button type="button" class="mt-1 text-[10px] text-[#22D3EE] hover:underline font-semibold">Rollback to Rev #1</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Autosave & LocalStorage Debouncer Script -->
  <script>
    const saveBadge = document.getElementById('save-status-badge');
    const titleInput = document.getElementById('entry-title-input') as HTMLInputElement;

    let timeoutId: any = null;
    if (titleInput && saveBadge) {
      titleInput.addEventListener('input', () => {
        saveBadge.textContent = '● AUTOSAVING...';
        saveBadge.className = 'px-2 py-0.5 text-[10px] font-mono rounded bg-amber-500/20 text-amber-300 font-semibold';
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
          localStorage.setItem('draft-entry-autosave', titleInput.value);
          saveBadge.textContent = '● SYNCED';
          saveBadge.className = 'px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-500/20 text-emerald-400 font-semibold';
        }, 1000);
      });
    }
  </script>
</DashboardLayout>
