---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { JournalTemplateCreator } from '../../../components/dashboard/JournalTemplateCreator';
---

<DashboardLayout title="Create Entry — Private Dashboard" activeSection="journal">
  <div class="journal-create-shell">
    <div class="journal-create-header">
      <div>
        <span class="journal-create-kicker">Command Center / Journal</span>
        <h2>Create a new entry</h2>
        <p>Start with a focused structure, then shape the story in the editor.</p>
      </div>
      <a href="/dashboard/journal">← Back to journal</a>
    </div>

    <JournalTemplateCreator client:load />
  </div>
</DashboardLayout>
