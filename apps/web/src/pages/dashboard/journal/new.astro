---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { JournalTemplateCreator } from '../../../components/dashboard/JournalTemplateCreator';
---

<DashboardLayout title="Create Entry — Private Dashboard" activeSection="journal">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Create New Content Entry</h2>
        <p class="text-xs text-[#9CAAC1] mt-1">
          Select a template to initialize a canonical structured draft.
        </p>
      </div>
      <a href="/dashboard/journal" class="text-xs text-[#9CAAC1] hover:text-white transition-colors"
        >← Back to List</a
      >
    </div>

    <JournalTemplateCreator client:load />
  </div>
</DashboardLayout>
