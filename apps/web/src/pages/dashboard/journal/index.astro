---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { PrivateRecordDirectory } from '../../../components/dashboard/PrivateRecordDirectory';
---

<DashboardLayout title="Journal — Command Center" activeSection="journal"
  ><section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-white">Journal & Content Engine</h1><p
          class="mt-1 text-xs text-[#9CAAC1]"
        >
          Live versioned content records from D1.
        </p>
      </div><a
        href="/dashboard/journal/new"
        class="rounded-lg bg-[#45F3FF] px-4 py-2 text-xs font-bold text-[#05060A]">New entry</a
      >
    </header><PrivateRecordDirectory kind="journal" client:load />
  </section></DashboardLayout
>
