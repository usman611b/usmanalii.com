---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { SkillsEvidenceGraph } from '../../../components/SkillsEvidenceGraph';
import { CareerRoleManager } from '../../../components/dashboard/CareerRoleManager';
---

<DashboardLayout title="Career Knowledge Universe — Private Dashboard" activeSection="graph">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Career Knowledge Universe</h2>
        <p class="text-xs text-[#9CAAC1] mt-1">
          Start broad with your roles and projects, then focus into skills, evidence, journey
          entries, artifacts, decisions, experiments, debugging lessons, and deployments.
        </p>
      </div>
    </div>

    <CareerRoleManager client:load />
    <SkillsEvidenceGraph
      client:load
      privateView={true}
      endpointUrl="/api/v1/private/graph/career"
    />
  </div>
</DashboardLayout>
