---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'ev-1' } },
    { params: { id: 'ev-2' } },
    { params: { id: 'ev-3' } },
  ];
}

const { id } = Astro.params;

const evidenceItem = {
  id: id || 'ev-1',
  title: 'Monorepo Security Architecture & CSP Boundary',
  description: 'Formal architectural decision record defining Cloudflare Access JWT verification, CSRF origin checks, strict Content Security Policy, and opaque error responses.',
  visibility: 'public',
  versionNo: 1,
};
---

<DashboardLayout title={`Edit Evidence ${id} — Private Dashboard`} activeSection="evidence">
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Edit Evidence Record</h2>
        <p class="text-xs text-[#9CAAC1] mt-1">Optimistic concurrency control active (`version_no: {evidenceItem.versionNo}`).</p>
      </div>
      <a href={`/dashboard/evidence/${id}`} class="text-xs text-[#9CAAC1] hover:text-white">← Cancel & Return</a>
    </div>

    <form class="p-6 rounded-xl glass-panel space-y-4 border border-white/10" method="POST" action={`/api/v1/private/evidence/${id}`}>
      <input type="hidden" name="versionNo" value={evidenceItem.versionNo} />

      <div>
        <label for="title" class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value={evidenceItem.title}
          required
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        />
      </div>

      <div>
        <label for="description" class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1">Description</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        >{evidenceItem.description}</textarea>
      </div>

      <div>
        <label for="visibility" class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1">Visibility</label>
        <select
          id="visibility"
          name="visibility"
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        >
          <option value="private" selected={evidenceItem.visibility === 'private'}>Private</option>
          <option value="restricted" selected={evidenceItem.visibility === 'restricted'}>Restricted</option>
          <option value="unlisted" selected={evidenceItem.visibility === 'unlisted'}>Unlisted</option>
          <option value="public" selected={evidenceItem.visibility === 'public'}>Public</option>
        </select>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3">
        <a href={`/dashboard/evidence/${id}`} class="px-4 py-2 bg-white/5 text-xs text-[#9CAAC1] rounded-lg hover:text-white">Cancel</a>
        <button type="submit" class="px-4 py-2 bg-[#22D3EE] text-[#050509] font-bold text-xs rounded-lg hover:opacity-90">
          Update Evidence
        </button>
      </div>
    </form>
  </div>
</DashboardLayout>
