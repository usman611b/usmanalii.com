---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { PrivateRecordDirectory } from '../../../components/dashboard/PrivateRecordDirectory';
---

<DashboardLayout title="Evidence Ledger — Command Center" activeSection="evidence"
  ><section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-white">Evidence Ledger</h1><p
          class="mt-1 text-xs text-[#9CAAC1]"
        >
          Live evidence and verification state from D1.
        </p>
      </div><a
        href="/dashboard/evidence/new"
        class="rounded-lg bg-[#45F3FF] px-4 py-2 text-xs font-bold text-[#05060A]">Add evidence</a
      >
    </header><PrivateRecordDirectory kind="evidence" client:load />
  </section></DashboardLayout
>
