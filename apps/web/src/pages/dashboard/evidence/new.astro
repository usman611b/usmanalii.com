---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="New Evidence — Private Dashboard" activeSection="evidence">
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Create New Evidence Record</h2>
        <p class="text-xs text-[#9CAAC1] mt-1">
          Manual proof record addition. All records default to private.
        </p>
      </div>
      <a href="/dashboard/evidence" class="text-xs text-[#9CAAC1] hover:text-white"
        >← Back to Ledger</a
      >
    </div>

    <form
      class="p-6 rounded-xl glass-panel space-y-4 border border-white/10"
      method="POST"
      action="/api/v1/private/evidence"
    >
      <div>
        <label
          for="title"
          class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
          >Title</label
        >
        <input
          type="text"
          id="title"
          name="title"
          required
          placeholder="e.g. Implementation of RS256 JWT Authorization Engine"
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label
            for="evidenceType"
            class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
            >Evidence Type</label
          >
          <select
            id="evidenceType"
            name="evidenceType"
            class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
          >
            <option value="commit">Commit</option>
            <option value="pull_request">Pull Request</option>
            <option value="repository">Repository</option>
            <option value="deployment">Deployment</option>
            <option value="project_artifact">Project Artifact</option>
            <option value="experiment">Experiment</option>
            <option value="adr">ADR</option>
            <option value="debugging_lesson">Debugging Lesson</option>
            <option value="certification">Certification</option>
            <option value="education_record">Education Record</option>
            <option value="employment_record">Employment Record</option>
            <option value="external_publication">External Publication</option>
            <option value="manual_evidence">Manual Evidence</option>
          </select>
        </div>

        <div>
          <label
            for="sourceType"
            class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
            >Source Type</label
          >
          <select
            id="sourceType"
            name="sourceType"
            class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
          >
            <option value="owner_attested">Owner Attested</option>
            <option value="github">GitHub</option>
            <option value="url">URL</option>
            <option value="file">File</option>
            <option value="manual">Manual</option>
            <option value="integration">Integration</option>
          </select>
        </div>
      </div>

      <div>
        <label
          for="canonicalLocator"
          class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
          >Source URL / Locator</label
        >
        <input
          type="url"
          id="canonicalLocator"
          name="canonicalLocator"
          placeholder="https://github.com/org/repo/commit/sha"
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        />
      </div>

      <div>
        <label
          for="description"
          class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
          >Description & Rationale</label
        >
        <textarea
          id="description"
          name="description"
          rows="3"
          placeholder="Context, engineering details, or evidence rationale..."
          class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
        ></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label
            for="visibility"
            class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
            >Initial Visibility</label
          >
          <select
            id="visibility"
            name="visibility"
            class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
          >
            <option value="private">Private (Recommended)</option>
            <option value="restricted">Restricted</option>
            <option value="unlisted">Unlisted</option>
            <option value="public">Public</option>
          </select>
        </div>

        <div>
          <label
            for="occurredAt"
            class="block text-xs font-semibold text-[#9CAAC1] uppercase tracking-wider mb-1"
            >Event Date / Time</label
          >
          <input
            type="datetime-local"
            id="occurredAt"
            name="occurredAt"
            class="w-full bg-[#101A31] text-xs text-white border border-white/10 rounded-lg px-3 py-2 focus:outline-none focus:border-[#22D3EE]"
          />
        </div>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3">
        <a
          href="/dashboard/evidence"
          class="px-4 py-2 bg-white/5 text-xs text-[#9CAAC1] rounded-lg hover:text-white">Cancel</a
        >
        <button
          type="submit"
          class="px-4 py-2 bg-[#22D3EE] text-[#050509] font-bold text-xs rounded-lg hover:opacity-90"
        >
          Save Evidence Record
        </button>
      </div>
    </form>
  </div>
</DashboardLayout>
