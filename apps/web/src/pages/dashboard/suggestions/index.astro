---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { PrivateRecordDirectory } from '../../../components/dashboard/PrivateRecordDirectory';
---

<DashboardLayout title="Suggestions — Private Dashboard" activeSection="suggestions"
  ><section class="space-y-6">
    <header>
      <h1 class="text-xl font-bold text-white">Owner Suggestion Review</h1><p
        class="mt-1 text-xs text-[#9CAAC1]"
      >
        Only persisted proposals are shown; suggestions never become facts without approval.
      </p>
    </header><PrivateRecordDirectory kind="suggestions" client:load />
  </section></DashboardLayout
>
