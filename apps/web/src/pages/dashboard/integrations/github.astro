---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { GitHubEvidenceManager } from '../../../components/dashboard/GitHubEvidenceManager';
---

<DashboardLayout title="GitHub Evidence Integration — Private Dashboard" activeSection="github">
  <div class="space-y-6 max-w-7xl mx-auto">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">GitHub Evidence Integration</h1>
      <p class="text-xs text-[#9CAAC1] mt-1">
        Incremental synchronization, owner commit attribution, and private candidate review queue.
      </p>
    </div>

    <GitHubEvidenceManager client:load />
  </div>
</DashboardLayout>
