---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { GitHubEvidenceManager } from '../../../components/dashboard/GitHubEvidenceManager';
---

<DashboardLayout title="GitHub Evidence Integration — Command Center" activeSection="github">
  <div class="space-y-6 max-w-7xl mx-auto font-mono-tech">
    <div class="border-b border-white/10 pb-4">
      <h1 class="text-sm font-bold text-white tracking-wide">GitHub Evidence Integration</h1>
      <p class="text-xs text-[#9CAAC1] mt-1">
        Incremental synchronization, owner commit attribution, and private candidate review queue.
      </p>
    </div>

    <GitHubEvidenceManager client:load />
  </div>
</DashboardLayout>
