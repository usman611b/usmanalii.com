---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    id: 'entry-1',
    title: 'Monorepo Security Architecture & WebCrypto JWT Pipeline',
    slug: 'monorepo-security-architecture',
    contentType: 'deep_dive',
    summary:
      'Architectural documentation of RS256 token verification, Cloudflare Access integration, CSP headers, and fail-closed D1 storage.',
    occurredAt: '2026-08-08',
    readingTime: '6 min read',
    tags: ['Cloudflare Workers', 'TypeScript', 'WebCrypto', 'Security'],
  },
  {
    id: 'entry-2',
    title: 'Building the Versioned JSON-Block Content Engine (M2)',
    slug: 'building-versioned-json-block-content-engine',
    contentType: 'journal',
    summary:
      'Design and implementation of canonical structured JSON blocks, optimistic concurrency version_no, GFM export, and publication validation.',
    occurredAt: '2026-08-08',
    readingTime: '4 min read',
    tags: ['Astro', 'TypeScript', 'Zod', 'D1'],
  },
];
---

<BaseLayout
  title="Learning Journey — USMAN ALI"
  description="Chronological record of technical learning, architectural decisions, breakthroughs, and retrospectives."
  currentPath="/journey"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="space-y-4">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#08111F] border border-[#45F3FF]/30 font-mono-tech text-xs text-[#45F3FF]"
      >
        <span class="w-2 h-2 rounded-full bg-[#45F3FF] animate-pulse"></span>
        <span>CHRONOLOGICAL ENGINEERING LOG</span>
      </div>

      <h1
        class="text-6xl sm:text-7xl font-display font-bold tracking-tight text-white uppercase leading-none"
      >
        LEARNING JOURNEY &amp; JOURNAL
      </h1>
      <p class="text-base text-[#9CAAC1] max-w-2xl">
        Transparent record of architectural decisions, systems implementation, debugging
        retrospectives, and verified breakthroughs.
      </p>
    </div>

    <!-- Filter Bar -->
    <div
      class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl glass-panel font-mono-tech text-xs"
    >
      <div
        class="flex flex-wrap items-center gap-2"
        role="tablist"
        aria-label="Content type filter"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="px-3 py-1.5 rounded-lg bg-[#45F3FF] text-[#05060A] font-bold transition-all uppercase"
        >
          All Entries
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="px-3 py-1.5 rounded-lg text-[#9CAAC1] hover:text-white transition-colors uppercase"
        >
          Journals
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="px-3 py-1.5 rounded-lg text-[#9CAAC1] hover:text-white transition-colors uppercase"
        >
          Deep Dives
        </button>
      </div>

      <div class="flex items-center gap-2 text-[#9CAAC1]">
        <span>CHRONOLOGY:</span>
        <select
          aria-label="Filter entries by date"
          class="px-3 py-1.5 bg-[#070A11] border border-white/10 rounded-lg text-xs text-white focus:outline-none focus:border-[#45F3FF]"
        >
          <option value="2026-08">August 2026</option>
          <option value="all">All Dates</option>
        </select>
      </div>
    </div>

    <!-- Timeline Rail Entries -->
    <div class="space-y-6 relative pl-6 border-l border-white/10">
      {
        entries.map((entry) => (
          <article class="relative p-6 sm:p-8 rounded-2xl glass-panel border border-white/10 hover:border-[#45F3FF]/50 transition-all space-y-4 group">
            <span class="absolute -left-[31px] top-8 w-3 h-3 rounded-full bg-[#45F3FF] ring-4 ring-[#45F3FF]/20" />

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 border-b border-white/5 pb-4 font-mono-tech text-xs">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded bg-[#45F3FF]/15 text-[#45F3FF] border border-[#45F3FF]/30 font-bold uppercase">
                  {entry.contentType.replace('_', ' ')}
                </span>
                <span class="text-[#9CAAC1]">{entry.occurredAt}</span>
              </div>
              <span class="text-[#9CAAC1]">{entry.readingTime}</span>
            </div>

            <div class="space-y-2">
              <h2 class="text-2xl font-bold text-white group-hover:text-[#45F3FF] transition-colors font-display uppercase tracking-wide">
                <a href={`/journey/${entry.slug}`}>{entry.title}</a>
              </h2>
              <p class="text-sm text-[#9CAAC1] leading-relaxed">{entry.summary}</p>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-2 font-mono-tech text-xs">
              <div class="flex flex-wrap gap-1.5">
                {entry.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-[10px] text-[#9CAAC1] bg-white/5 rounded border border-white/5">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={`/journey/${entry.slug}`}
                class="font-bold text-[#45F3FF] hover:underline inline-flex items-center gap-1"
              >
                Read Entry →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
