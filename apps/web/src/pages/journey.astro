---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Journey — usmanalii.com" description="Chronological learning and engineering journey" currentPath="/journey">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-4">
      <h1 class="text-3xl font-bold text-white tracking-tight">Learning Journey & Engineering Journal</h1>
      <p class="text-sm text-[#9CAAC1] max-w-2xl">
        Chronological record of learning, architectural decisions, breakthroughs, and retrospectives.
      </p>
    </div>

    <!-- Timeline Placeholder Container -->
    <div class="mt-12 space-y-6">
      <div class="p-6 rounded-2xl glass-panel">
        <span class="text-xs text-[#22D3EE] font-mono">2026-08-08 · Journal Entry</span>
        <h2 class="text-lg font-bold text-white mt-1">Building the Monorepo & Security Baseline (M0 & M1)</h2>
        <p class="text-xs text-[#9CAAC1] mt-2">
          Established the 14-package pnpm monorepo, strict TypeScript boundaries, WebCrypto RS256 JWT validation, and D1 migrations 001–006.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
