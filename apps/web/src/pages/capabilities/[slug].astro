---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RecordDetail } from '../../components/RecordDetail';
const slug = Astro.url.searchParams.get('slug') ?? Astro.params.slug;
export function getStaticPaths() {
  return [{ params: { slug: 'record' } }];
}
---

<BaseLayout title="Capability — USMAN ALI" currentPath="/capabilities"
  ><main class="public-page-shell mx-auto max-w-7xl px-4 py-12">
    <RecordDetail
      endpoint={`/api/v1/public/capabilities/${encodeURIComponent(slug ?? '')}`}
      client:load
    />
  </main></BaseLayout
>
