---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ModeSwitcher } from '../../components/ModeSwitcher';

const publicCapabilities = [
  {
    title: 'Design Secure Multi-Tenant APIs',
    slug: 'design-secure-multi-tenant-apis',
    description: 'Design authorization boundaries that prevent cross-owner data access on Cloudflare Workers.',
    outcomeStatement: 'Delivers multi-tenant APIs with zero IDOR vulnerabilities and Cloudflare Access verification.',
    stage: 'delivered',
    evidenceCount: 6,
  },
  {
    title: 'Diagnose Production Reliability Failures',
    slug: 'diagnose-production-failures',
    description: 'Analyzes runtime stack traces, worker logs, and D1 constraint failures to isolate root cause.',
    outcomeStatement: 'Resolves production incidents without masking errors or introducing silent fallbacks.',
    stage: 'applied',
    evidenceCount: 4,
  },
];
---

<BaseLayout title="Capabilities — usmanalii.com" currentPath="/capabilities">
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">Demonstrated Capabilities</h1>
        <p class="text-xs text-[#9CAAC1] mt-1">Demonstrated outcome statements backed by verifiable evidence. Descriptive maturity only.</p>
      </div>
      <ModeSwitcher client:load />
    </div>

    <div class="space-y-6">
      {publicCapabilities.map((cap) => (
        <a
          href={`/capabilities/${cap.slug}`}
          class="p-6 rounded-2xl glass-panel border border-white/10 hover:border-[#22D3EE] transition-all group block space-y-3"
        >
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 rounded bg-[#22D3EE]/10 text-[#22D3EE] border border-[#22D3EE]/20 font-medium text-xs capitalize">
              Stage: {cap.stage}
            </span>
            <span class="text-xs text-[#9CAAC1] font-mono">{cap.evidenceCount} Verified Items</span>
          </div>
          <h2 class="text-xl font-bold text-white group-hover:text-[#22D3EE] transition-colors">{cap.title}</h2>
          <p class="text-xs font-semibold text-white">Outcome: {cap.outcomeStatement}</p>
          <p class="text-xs text-[#9CAAC1] leading-relaxed">{cap.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
