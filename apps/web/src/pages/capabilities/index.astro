---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PublicRecordDirectory } from '../../components/PublicRecordDirectory';
---

<BaseLayout
  title="Capabilities — USMAN ALI"
  description="Outcome-based professional capabilities connected to approved evidence."
  currentPath="/capabilities"
>
  <div class="public-page-shell max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10">
    <header class="public-page-header space-y-4 max-w-3xl">
      <div class="hero-eyebrow"><span></span>Outcome-based capability graph</div>
      <h1 class="public-page-title">Capabilities</h1>
      <p class="text-base leading-relaxed" style="color: var(--text-secondary); max-width: 62ch;">
        What I can deliver, expressed as outcomes and connected to approved evidence—not arbitrary
        proficiency scores.
      </p>
    </header>
    <hr class="luminous-rule" aria-hidden="true" />
    <PublicRecordDirectory kind="capabilities" client:load />
  </div>
</BaseLayout>
