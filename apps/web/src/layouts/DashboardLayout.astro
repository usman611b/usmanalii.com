---
import '../styles/global.css';

interface Props {
  title?: string;
  activeSection?: string;
  description?: string;
  currentPath?: string;
}

const { title = 'Command Center — USMAN ALI', activeSection = 'overview' } = Astro.props;

const dashboardLinks = [
  { href: '/dashboard', id: 'overview', label: 'Overview', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  {
    href: '/dashboard/journal',
    id: 'journal',
    label: 'Journal',
    icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z',
  },
  {
    href: '/dashboard/evidence',
    id: 'evidence',
    label: 'Evidence',
    icon: 'M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z',
  },
  {
    href: '/dashboard/projects',
    id: 'projects',
    label: 'Projects',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    href: '/dashboard/skills',
    id: 'skills',
    label: 'Skills',
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z',
  },
  {
    href: '/dashboard/integrations/github',
    id: 'github',
    label: 'GitHub',
    icon: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
  },
  {
    href: '/dashboard/activity',
    id: 'activity',
    label: 'Activity',
    icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z',
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#05060A] text-[#F4F1EA] flex min-h-screen font-sans selection:bg-[#45F3FF]/20 selection:text-[#45F3FF]"
  >
    <!-- Compact Left Navigation Rail -->
    <aside
      class="w-56 border-r border-white/10 bg-[#070A11] flex flex-col p-4 justify-between font-mono-tech"
    >
      <div class="space-y-6">
        <a
          href="/"
          class="flex items-center space-x-3 px-2 py-1 text-xs font-mono-tech transition-opacity hover:opacity-90"
        >
          <svg
            class="w-5 h-5 text-[#45F3FF]"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M6 8V18C6 21.3137 8.68629 24 12 24C15.3137 24 18 21.3137 18 18V8"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <path
              d="M18 24L26 8M21 17H26.5"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="h-3.5 w-px bg-white/20 inline-block"></span>
          <span class="text-xs font-semibold tracking-wider text-white lowercase"
            >usmanalii.com</span
          >
        </a>

        <nav class="space-y-1" aria-label="Dashboard Navigation">
          {
            dashboardLinks.map((link) => {
              const isActive = activeSection === link.id;
              return (
                <a
                  href={link.href}
                  class={`flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition-all ${
                    isActive
                      ? 'bg-[#0C1626] text-[#45F3FF] font-semibold border border-[#45F3FF]/30 shadow-sm'
                      : 'text-[#9CAAC1] hover:text-white hover:bg-white/5'
                  }`}
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d={link.icon} />
                  </svg>
                  <span>{link.label}</span>
                </a>
              );
            })
          }
        </nav>
      </div>

      <div class="pt-4 border-t border-white/10 space-y-3 text-[11px] text-[#9CAAC1]">
        <div class="flex items-center space-x-2 text-[#45F3FF]">
          <span class="w-2 h-2 rounded-full bg-[#B8FF5A]"></span>
          <span>usmanalii.com</span>
        </div>
        <div class="text-[10px] text-[#9CAAC1]">Personal Career OS</div>
        <a href="/" class="block text-xs text-[#9CAAC1] hover:text-white pt-1">
          ← Back to Public Site
        </a>
      </div>
    </aside>

    <!-- Main Command Operations Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Command Top Header -->
      <header
        class="h-14 border-b border-white/10 bg-[#070A11]/90 px-6 flex items-center justify-between font-mono-tech text-xs"
      >
        <div class="flex items-center space-x-4">
          <h1 class="font-bold text-white tracking-wide text-sm">Command Center</h1>
          <span
            class="text-[#8B5CFF] bg-[#8B5CFF]/10 px-2 py-0.5 rounded border border-[#8B5CFF]/30"
          >
            🔒 Protected Session • Owner only
          </span>
          <span class="hidden md:inline text-[#9CAAC1]">
            Current focus: <span class="text-[#45F3FF]"
              >Evidence graph management &amp; workflow execution</span
            >
          </span>
        </div>

        <div class="flex items-center space-x-4 text-[#9CAAC1]">
          <span id="pkt-clock" class="text-[#45F3FF] font-bold">&gt;_ --:--:-- PKT</span>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6 space-y-6">
        <slot />
      </main>

      <!-- Footer Bar -->
      <footer
        class="h-10 border-t border-white/10 bg-[#070A11] px-6 flex items-center justify-between font-mono-tech text-[11px] text-[#9CAAC1]"
      >
        <span>&gt; Keep building. Keep documenting. The graph is you.</span>
        <div class="flex items-center space-x-3">
          <span>Backed up 2h ago</span>
          <span>•</span>
          <span class="text-[#B8FF5A]">Graph healthy</span>
        </div>
      </footer>
    </div>

    <script>
      const clockEl = document.getElementById('pkt-clock');
      function updateClock() {
        if (!clockEl) return;
        const now = new Date();
        const options: Intl.DateTimeFormatOptions = {
          timeZone: 'Asia/Karachi',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        };
        const pktTime = new Intl.DateTimeFormat('en-US', options).format(now);
        clockEl.textContent = `>_ ${pktTime} PKT`;
      }
      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>
