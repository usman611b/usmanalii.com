---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen font-[var(--font-primary)]">
    <!-- Skip navigation -->
    <a href="#dashboard-main" class="skip-nav">Skip to main content</a>

    <!-- ── Left Navigation Rail ─────────────────────────────────────────── -->
    <aside
      id="dashboard-nav"
      class="hidden md:flex w-56 flex-shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--obsidian)]"
      aria-label="Dashboard Navigation"
    >
      <!-- Brand -->
      <div class="px-4 py-5 border-b border-[var(--hairline)]">
        <a
          href="/"
          class="flex items-center gap-2.5 group"
          aria-label="Back to public site — usmanalii.com"
        >
          <svg
            class="w-5 h-5 text-[var(--cyan)]"
            viewBox="0 0 32 32"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 8V18C6 21.3137 8.68629 24 12 24C15.3137 24 18 21.3137 18 18V8"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <path
              d="M18 24L26 8M21 17H26.5"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span
            class="text-xs font-semibold tracking-wide text-[var(--text-primary)] group-hover:text-[var(--cyan)] transition-colors duration-[150ms] font-[var(--font-mono)]"
            >Command Center</span
          >
        </a>
      </div>

      <!-- Navigation groups -->
      <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-6" aria-label="Dashboard sections">
        {
          navGroups.map((group) => (
            <div>
              <div class="px-2 mb-1.5 text-[10px] font-semibold uppercase tracking-widest text-[var(--text-muted)] font-[var(--font-mono)]">
                {group.label}
              </div>
              <div class="space-y-0.5">
                {group.items.map((item) => {
                  const isActive = activeSection === item.id;
                  return (
                    <a
                      href={item.href}
                      class={`flex items-center gap-2.5 px-2 py-2 rounded-lg text-xs font-medium transition-all duration-[150ms] ${
                        isActive
                          ? 'bg-[var(--elevated)] text-[var(--cyan)] border border-[var(--border-cyan)]'
                          : 'text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/5'
                      }`}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <svg
                        class="w-4 h-4 flex-shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath} />
                      </svg>
                      <span>{item.label}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))
        }
      </nav>

      <!-- Footer: Auth indicator + back link -->
      <div class="px-4 py-4 border-t border-[var(--hairline)] space-y-3">
        <div class="flex items-center gap-2">
          <span class="status-dot status-dot-active" aria-hidden="true"></span>
          <span class="text-[11px] text-[var(--text-muted)] font-[var(--font-mono)]"
            >Owner session</span
          >
          <span
            class="ml-auto text-[10px] px-1.5 py-0.5 rounded bg-[var(--elevated)] text-[var(--violet)] border border-[var(--border-violet)] font-[var(--font-mono)] font-semibold"
            >🔒</span
          >
        </div>
        <a
          href="/"
          class="block text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors font-[var(--font-mono)]"
        >
          ← Public site
        </a>
      </div>
    </aside>

    <!-- ── Main Area ────────────────────────────────────────────────────── -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Top bar -->
      <header
        class="command-topbar flex-shrink-0 min-h-16 border-b border-[var(--hairline)] bg-[var(--obsidian)]/95 px-4 sm:px-6 flex items-center gap-4"
      >
        <!-- Mobile menu toggle -->
        <button
          type="button"
          id="dash-menu-btn"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-white/5 transition-colors"
          aria-label="Open dashboard navigation"
          aria-expanded="false"
          aria-controls="dashboard-nav"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <div class="flex items-center gap-3 min-w-0 flex-shrink-0">
          <h1
            class="text-sm font-bold text-[var(--text-primary)] tracking-wide font-[var(--font-mono)] truncate"
          >
            {title.replace(' — Command Center', '')}
          </h1>
          <span
            class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-[var(--font-mono)] px-2 py-0.5 rounded bg-[var(--elevated)] text-[var(--violet)] border border-[var(--border-violet)]"
          >
            🔒 Protected Session · Owner only
          </span>
        </div>

        <label
          class="command-search hidden lg:flex flex-1 max-w-2xl mx-auto"
          aria-label="Search records or run a command"
        >
          <span aria-hidden="true">⌕</span>
          <input
            type="search"
            placeholder="Search records or run a command…"
            disabled
            title="Command search will be enabled when indexed private search is available"
          />
          <kbd>⌘K</kbd>
        </label>

        <div class="flex items-center gap-3 flex-shrink-0 ml-auto">
          <span class="command-environment">Staging</span>
          <span
            id="pkt-clock"
            class="text-[11px] font-[var(--font-mono)] text-[var(--cyan)] tabular-nums"
            aria-label="Current time in Pakistan Standard Time"
          >
            &gt;_ --:--:-- PKT
          </span>
        </div>
      </header>

      <!-- Main workspace -->
      <main id="dashboard-main" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">
        <slot />
      </main>

      <!-- Status footer — no hardcoded fake values -->
      <footer
        class="flex-shrink-0 h-10 border-t border-[var(--hairline)] bg-[var(--canvas)] px-4 sm:px-6 flex items-center justify-between text-[11px] text-[var(--text-muted)] font-[var(--font-mono)]"
      >
        <span>&gt; Keep building. Keep documenting. The graph is you.</span>
        <a href="/" class="hover:text-[var(--text-primary)] transition-colors">← Public site</a>
      </footer>
    </div>

    <script>
      // PKT Clock
      const clockEl = document.getElementById('pkt-clock');
      function updateClock() {
        if (!clockEl) return;
        const now = new Date();
        const pktTime = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Karachi',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        }).format(now);
        clockEl.textContent = `>_ ${pktTime} PKT`;
      }
      updateClock();
      void setInterval(updateClock, 1000);

      // Pause clock when tab hidden
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          updateClock();
        }
      });

      // Mobile nav toggle for dashboard
      const dashBtn = document.getElementById('dash-menu-btn');
      const dashNav = document.getElementById('dashboard-nav');

      dashBtn?.addEventListener('click', () => {
        const isOpen = dashBtn.getAttribute('aria-expanded') === 'true';
        dashBtn.setAttribute('aria-expanded', String(!isOpen));
        if (isOpen) {
          dashNav?.classList.add('hidden');
          dashNav?.classList.remove('flex');
        } else {
          dashNav?.classList.remove('hidden');
          dashNav?.classList.add(
            'flex',
            'fixed',
            'inset-y-0',
            'left-0',
            'z-[200]',
            'w-64',
            'shadow-2xl',
          );
        }
      });
    </script>
  </body>
</html>
