{
  "name": "@usmanalii/web",
  "version": "0.0.1",
  "private": true,
  "description": "Astro public site and authenticated dashboard shell.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist .astro *.tsbuildinfo"
  },
  "dependencies": {
    "@usmanalii/contracts": "workspace:*",
    "@usmanalii/design-system": "workspace:*",
    "astro": "^5.1.1",
    "@astrojs/react": "^4.1.0",
    "@astrojs/tailwind": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17"
  }
}
