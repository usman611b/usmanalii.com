{
  "name": "@usmanalii/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker API — routes, authentication, jobs and webhook handlers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --port 8788 --persist-to=../../.wrangler/codex-local-dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir=dist",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@usmanalii/authorization": "workspace:*",
    "@usmanalii/content": "workspace:*",
    "@usmanalii/contracts": "workspace:*",
    "@usmanalii/database": "workspace:*",
    "@usmanalii/domain": "workspace:*",
    "@usmanalii/evidence": "workspace:*",
    "@usmanalii/observability": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
