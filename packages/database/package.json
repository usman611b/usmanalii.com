{
  "name": "@usmanalii/database",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare D1 repositories, migrations and fixtures. All queries are parameterized.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./migrations"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "migrate:local": "wrangler d1 execute usmanalii-local --local --file=migrations/001_initial.sql",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@usmanalii/authorization": "workspace:*",
    "@usmanalii/content": "workspace:*",
    "@usmanalii/contracts": "workspace:*",
    "@usmanalii/domain": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
